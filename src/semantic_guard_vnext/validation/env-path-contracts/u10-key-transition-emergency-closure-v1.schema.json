{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/vnext/schemas/u10-key-transition-emergency-closure-v1.schema.json",
  "title": "U-10 human-authorized emergency key transition closure v1",
  "description": "Records closure or quarantine of an incomplete transition. It never establishes transition success.",
  "type": "object",
  "required": ["schema_version", "closure_id", "record_kind", "authorization_ref", "consumption_ref", "prior_selector_ref", "published_selector_ref", "closure_disposition", "closure_reason", "human_decision", "decision_owner", "recorded_at", "u4_principal_authenticity", "formal_authority", "positive_assurance_allowed", "transition_success_claimed", "closure_digest"],
  "properties": {
    "schema_version": {"const": "semantic-guard-u10-key-transition-emergency-closure/v1"},
    "closure_id": {"$ref": "#/$defs/id"},
    "record_kind": {"const": "key_transition_emergency_closure"},
    "authorization_ref": {"$ref": "#/$defs/authorization_ref"},
    "consumption_ref": {"$ref": "#/$defs/consumption_ref"},
    "prior_selector_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/selector_ref"}]},
    "published_selector_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/selector_ref"}]},
    "closure_disposition": {"enum": ["abandoned_before_publication", "quarantined_after_publication"]},
    "closure_reason": {"type": "string", "minLength": 1, "maxLength": 4096},
    "human_decision": {"const": "accept_emergency_closure"},
    "decision_owner": {"const": "human"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "u4_principal_authenticity": {"const": "unresolved"},
    "formal_authority": {"const": "human_emergency_closure_decision_only"},
    "positive_assurance_allowed": {"const": false},
    "transition_success_claimed": {"const": false},
    "closure_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"closure_disposition": {"const": "abandoned_before_publication"}}, "required": ["closure_disposition"]},
      "then": {"properties": {"published_selector_ref": {"type": "null"}}},
      "else": {"properties": {"published_selector_ref": {"$ref": "#/$defs/selector_ref"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
    "digest": {"type": "object", "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "unevaluatedProperties": false},
    "authorization_ref": {"type": "object", "required": ["authorization_id", "locator", "artifact_digest", "authorization_digest"], "properties": {"authorization_id": {"$ref": "#/$defs/id"}, "locator": {"type": "string", "pattern": "^/Library/Application Support/semantic-guard/u10/activations/key-transitions/[A-Za-z0-9][A-Za-z0-9._-]{0,199}\\.authorization\\.json$"}, "artifact_digest": {"$ref": "#/$defs/digest"}, "authorization_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false},
    "consumption_ref": {"type": "object", "required": ["consumption_id", "locator", "artifact_digest", "consumption_digest"], "properties": {"consumption_id": {"$ref": "#/$defs/id"}, "locator": {"type": "string", "pattern": "^/Library/Application Support/semantic-guard/u10/activations/key-transitions/[A-Za-z0-9][A-Za-z0-9._-]{0,199}\\.consumption\\.json$"}, "artifact_digest": {"$ref": "#/$defs/digest"}, "consumption_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false},
    "selector_ref": {"type": "object", "required": ["selector_id", "locator", "artifact_digest", "selector_digest"], "properties": {"selector_id": {"$ref": "#/$defs/id"}, "locator": {"type": "string", "pattern": "^/Library/Application Support/semantic-guard/u10/keys/selector-history/sha256/[0-9a-f]{64}\\.json$"}, "artifact_digest": {"$ref": "#/$defs/digest"}, "selector_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false}
  },
  "unevaluatedProperties": false
}
