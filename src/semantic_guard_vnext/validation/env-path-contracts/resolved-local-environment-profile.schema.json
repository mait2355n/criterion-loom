{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/vnext/schemas/resolved-local-environment-profile.schema.json",
  "title": "semantic-guard resolved local environment candidate",
  "description": "Environment-specific candidate generated from logical tool requirements. Candidate state never means adoption.",
  "type": "object",
  "required": [
    "schema_version",
    "environment_profile_id",
    "environment_profile_version",
    "lifecycle_state",
    "formal_authority",
    "positive_assurance_allowed",
    "verification_profile_basis_digest",
    "platform",
    "host_identity_ref",
    "resolved_tools",
    "effective_path",
    "limitations",
    "basis_digest"
  ],
  "properties": {
    "schema_version": {"const": "semantic-guard-resolved-local-environment-profile/v0"},
    "environment_profile_id": {"$ref": "#/$defs/stable_id"},
    "environment_profile_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "lifecycle_state": {"const": "candidate"},
    "formal_authority": {"const": "none"},
    "positive_assurance_allowed": {"const": false},
    "verification_profile_basis_digest": {"$ref": "#/$defs/digest"},
    "platform": {"$ref": "#/$defs/platform"},
    "host_identity_ref": {"$ref": "#/$defs/host_identity_ref"},
    "resolved_tools": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/resolved_tool"}
    },
    "effective_path": {"$ref": "#/$defs/effective_path"},
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "basis_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "unevaluatedProperties": false
    },
    "digest_bound_ref": {
      "type": "object",
      "required": ["record_id", "locator", "content_digest"],
      "properties": {
        "record_id": {"$ref": "#/$defs/stable_id"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 4096},
        "content_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    },
    "host_identity_ref": {
      "type": "object",
      "required": ["host_id", "identity_digest", "evidence_ref"],
      "properties": {
        "host_id": {"$ref": "#/$defs/stable_id"},
        "identity_digest": {"$ref": "#/$defs/digest"},
        "evidence_ref": {"$ref": "#/$defs/digest_bound_ref"}
      },
      "unevaluatedProperties": false
    },
    "platform": {
      "type": "object",
      "required": ["system", "release", "machine"],
      "properties": {
        "system": {"type": "string", "minLength": 1, "maxLength": 128},
        "release": {"type": "string", "minLength": 1, "maxLength": 256},
        "machine": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "unevaluatedProperties": false
    },
    "constraint_evaluation": {
      "type": "object",
      "required": ["version_matches", "digest_matches", "platform_matches"],
      "properties": {
        "version_matches": {"const": true},
        "digest_matches": {"const": true},
        "platform_matches": {"const": true}
      },
      "unevaluatedProperties": false
    },
    "resolved_tool": {
      "type": "object",
      "required": [
        "tool_id",
        "candidate_source",
        "invocation_path",
        "resolved_path",
        "version",
        "version_probe",
        "file_digest",
        "constraint_evaluation"
      ],
      "properties": {
        "tool_id": {"$ref": "#/$defs/stable_id"},
        "candidate_source": {
          "enum": ["repository_relative", "explicit", "parent_path_discovery_only"]
        },
        "invocation_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "resolved_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "version_probe": {"enum": ["python", "uv"]},
        "file_digest": {"$ref": "#/$defs/digest"},
        "constraint_evaluation": {"$ref": "#/$defs/constraint_evaluation"}
      },
      "unevaluatedProperties": false
    },
    "path_entry": {
      "type": "object",
      "required": ["directory", "source_tool_ids"],
      "properties": {
        "directory": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source_tool_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        }
      },
      "unevaluatedProperties": false
    },
    "effective_path": {
      "type": "object",
      "required": ["policy", "entries", "rendered_value", "content_digest"],
      "properties": {
        "policy": {"const": "managed_minimal_from_adopted_tools"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/path_entry"}
        },
        "rendered_value": {"type": "string", "minLength": 1, "maxLength": 32768},
        "content_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    },
    "environment_profile_ref": {
      "type": "object",
      "required": ["environment_profile_id", "environment_profile_version", "basis_digest"],
      "properties": {
        "environment_profile_id": {"$ref": "#/$defs/stable_id"},
        "environment_profile_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "basis_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    },
    "adoption_ref": {
      "type": "object",
      "required": ["adoption_id", "adoption_version", "adoption_digest"],
      "properties": {
        "adoption_id": {"$ref": "#/$defs/stable_id"},
        "adoption_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "adoption_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    },
    "environment_observation": {
      "type": "object",
      "required": ["platform", "host_identity_ref", "resolved_tools", "effective_path"],
      "properties": {
        "platform": {"$ref": "#/$defs/platform"},
        "host_identity_ref": {"$ref": "#/$defs/host_identity_ref"},
        "resolved_tools": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/resolved_tool"}
        },
        "effective_path": {"$ref": "#/$defs/effective_path"}
      },
      "unevaluatedProperties": false
    },
    "candidate_environment_resolution": {
      "type": "object",
      "required": [
        "schema_version",
        "resolution_status",
        "reason_codes",
        "environment_use_allowed",
        "formal_authority",
        "positive_assurance_allowed",
        "environment_profile_ref",
        "adoption_ref",
        "trust_verifier_refs",
        "trust_claim_states",
        "current_observation",
        "observation_source",
        "resolved_tools",
        "effective_path",
        "child_process_observation",
        "limitations",
        "resolution_digest"
      ],
      "properties": {
        "schema_version": {"const": "semantic-guard-adopted-environment-candidate-resolution/v1"},
        "resolution_status": {"const": "candidate_execution_material"},
        "reason_codes": {
          "const": ["external_trust_control_not_integrated"]
        },
        "environment_use_allowed": {"const": false},
        "formal_authority": {"const": "none"},
        "positive_assurance_allowed": {"const": false},
        "environment_profile_ref": {"$ref": "#/$defs/environment_profile_ref"},
        "adoption_ref": {"$ref": "#/$defs/adoption_ref"},
        "trust_verifier_refs": {
          "type": "object",
          "required": ["decision_evidence", "host_identity"],
          "properties": {
            "decision_evidence": {"$ref": "#/$defs/digest_bound_ref"},
            "host_identity": {"$ref": "#/$defs/digest_bound_ref"}
          },
          "unevaluatedProperties": false
        },
        "trust_claim_states": {
          "type": "object",
          "required": ["decision_evidence", "host_identity"],
          "properties": {
            "decision_evidence": {"const": "verifier_claim_accepted"},
            "host_identity": {"const": "verifier_claim_accepted"}
          },
          "unevaluatedProperties": false
        },
        "current_observation": {"$ref": "#/$defs/environment_observation"},
        "observation_source": {"const": "internal_reobservation"},
        "resolved_tools": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/resolved_tool"}
        },
        "effective_path": {"$ref": "#/$defs/effective_path"},
        "child_process_observation": {"const": "not_implemented"},
        "limitations": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "resolution_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
