{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/vnext/schemas/u10-control-runtime-manifest-v1.schema.json",
  "title": "U-10 closed control runtime manifest v1",
  "type": "object",
  "required": ["schema_version", "runtime_id", "runtime_version", "runtime_root", "runtime_root_uid", "runtime_root_gid", "runtime_root_mode", "effective_interpreter_locator", "effective_interpreter_artifact_digest", "invocation_contract", "runtime_closure", "platform_binding", "tree_denominator", "trust_boundary", "formal_authority", "positive_assurance_allowed", "manifest_digest"],
  "properties": {
    "schema_version": {"const": "semantic-guard-u10-control-runtime-manifest/v1"}, "runtime_id": {"$ref": "#/$defs/id"}, "runtime_version": {"type": "string", "minLength": 1},
    "runtime_root": {"$ref": "#/$defs/path"}, "runtime_root_uid": {"const": 0}, "runtime_root_gid": {"type": "integer", "minimum": 0}, "runtime_root_mode": {"type": "integer", "minimum": 0, "maximum": 4095},
    "effective_interpreter_locator": {"$ref": "#/$defs/path"}, "effective_interpreter_artifact_digest": {"$ref": "#/$defs/digest"},
    "invocation_contract": {"type": "object", "required": ["python_flags", "site_policy", "required_modules"], "properties": {"python_flags": {"const": ["-I", "-B"]}, "site_policy": {"const": "qualified_closed_site_only_no_fallback/v1"}, "required_modules": {"const": ["cryptography", "jsonschema", "semantic_guard_u10_broker"]}}, "unevaluatedProperties": false},
    "runtime_closure": {"type": "object", "required": ["probe_profile", "required_modules", "sys_path", "site_roots", "imported_module_origins", "dyld_images"], "properties": {"probe_profile": {"const": "darwin-control-runtime-site-closure/v1"}, "required_modules": {"type": "array", "minItems": 3}, "sys_path": {"type": "array", "minItems": 1}, "site_roots": {"type": "array", "minItems": 1}, "imported_module_origins": {"type": "array", "minItems": 1}, "dyld_images": {"type": "array", "minItems": 1}}, "additionalProperties": true},
    "platform_binding": {"type": "object"}, "tree_denominator": {"type": "object", "required": ["status", "entry_count", "entries", "tree_digest"], "properties": {"status": {"const": "closed"}, "entry_count": {"type": "integer", "minimum": 1}, "entries": {"type": "array", "minItems": 1}, "tree_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false},
    "trust_boundary": {"type": "object", "required": ["covered", "not_claimed"], "properties": {"covered": {"const": "root_owned_control_runtime_and_exact_site_dependency_tree"}, "not_claimed": {"const": "root_os_or_hardware_compromise_resistance"}}, "unevaluatedProperties": false},
    "formal_authority": {"const": "none"}, "positive_assurance_allowed": {"const": false}, "manifest_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}, "path": {"type": "string", "pattern": "^/", "maxLength": 4096}, "digest": {"type": "object", "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "unevaluatedProperties": false}},
  "unevaluatedProperties": false
}
