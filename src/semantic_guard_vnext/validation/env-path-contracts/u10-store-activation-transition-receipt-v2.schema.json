{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/vnext/schemas/u10-store-activation-transition-receipt-v2.schema.json",
  "title": "semantic-guard U-10 append-only store activation transition receipt v2",
  "description": "A post-publication occurrence receipt using an honest observation interval. It does not pretend that receipt recovery time is the exact selector replacement time.",
  "type": "object",
  "required": [
    "schema_version", "receipt_id", "record_kind", "public_operation",
    "public_identifier", "authorization_id", "authorization_digest",
    "consumption_digest", "store_activation_basis_ref", "transition_kind",
    "prior_store_ref", "prior_revocation_ref", "activated_store_ref",
    "publisher_contract_binding",
    "publication_not_before", "publication_observed_at", "receipt_recorded_at",
    "formal_authority", "positive_assurance_allowed", "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "semantic-guard-u10-store-activation-transition-receipt/v2"},
    "receipt_id": {"$ref": "#/$defs/stable_id"},
    "record_kind": {"const": "activation_transition_occurrence"},
    "public_operation": {"const": "activate-store"},
    "public_identifier": {"$ref": "#/$defs/stable_id"},
    "authorization_id": {"$ref": "#/$defs/stable_id"},
    "authorization_digest": {"$ref": "#/$defs/digest"},
    "consumption_digest": {"$ref": "#/$defs/digest"},
    "store_activation_basis_ref": {"$ref": "#/$defs/root_artifact_ref"},
    "transition_kind": {"enum": ["initial_activation", "replace_current_revision"]},
    "prior_store_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/store_ref"}]},
    "prior_revocation_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/revocation_ref"}]},
    "activated_store_ref": {"$ref": "#/$defs/store_ref"},
    "publisher_contract_binding": {"$ref": "#/$defs/publisher_contract_binding"},
    "publication_not_before": {"type": "string", "format": "date-time"},
    "publication_observed_at": {"type": "string", "format": "date-time"},
    "receipt_recorded_at": {"type": "string", "format": "date-time"},
    "formal_authority": {"const": "none"},
    "positive_assurance_allowed": {"const": false},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "digest": {"type": "object", "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "unevaluatedProperties": false},
    "root_artifact_ref": {"type": "object", "required": ["record_id", "locator", "artifact_digest", "semantic_digest"], "properties": {"record_id": {"$ref": "#/$defs/stable_id"}, "locator": {"type": "string", "pattern": "^/Library/Application Support/semantic-guard/u10/store-activation-bases/", "maxLength": 4096}, "artifact_digest": {"$ref": "#/$defs/digest"}, "semantic_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false},
    "store_ref": {"type": "object", "required": ["store_id", "store_revision_id", "store_version", "store_activation_basis_digest", "artifact_digest", "semantic_digest"], "properties": {"store_id": {"$ref": "#/$defs/stable_id"}, "store_revision_id": {"$ref": "#/$defs/stable_id"}, "store_version": {"type": "string", "minLength": 1, "maxLength": 128}, "store_activation_basis_digest": {"$ref": "#/$defs/digest"}, "artifact_digest": {"$ref": "#/$defs/digest"}, "semantic_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false},
    "revocation_ref": {"type": "object", "required": ["revocation_id", "artifact_digest", "semantic_digest"], "properties": {"revocation_id": {"$ref": "#/$defs/stable_id"}, "artifact_digest": {"$ref": "#/$defs/digest"}, "semantic_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false},
    "publisher_contract_binding": {"type": "object", "required": ["schema_version", "contract_id", "binding_digest"], "properties": {"schema_version": {"const": "semantic-guard-u10-control-publisher-contract-binding/v1"}, "contract_id": {"const": "semantic-guard.u10.fixed-root-control-publisher.v1"}, "binding_digest": {"$ref": "#/$defs/digest"}}}
  },
  "allOf": [
    {"if": {"properties": {"transition_kind": {"const": "initial_activation"}}, "required": ["transition_kind"]}, "then": {"properties": {"prior_store_ref": {"type": "null"}, "prior_revocation_ref": {"type": "null"}}}},
    {"if": {"properties": {"transition_kind": {"const": "replace_current_revision"}}, "required": ["transition_kind"]}, "then": {"properties": {"prior_store_ref": {"$ref": "#/$defs/store_ref"}}}}
  ],
  "unevaluatedProperties": false
}
