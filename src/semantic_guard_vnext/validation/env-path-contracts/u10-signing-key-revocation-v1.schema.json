{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://semantic-guard.local/vnext/schemas/u10-signing-key-revocation-v1.schema.json", "title": "U-10 signing key revocation occurrence v1", "type": "object",
  "required": ["schema_version", "revocation_id", "record_kind", "key_id", "key_entity_ref", "authorization_ref", "revoked_at", "private_material_disposition", "formal_authority", "positive_assurance_allowed", "revocation_digest"],
  "properties": {"schema_version": {"const": "semantic-guard-u10-signing-key-revocation/v1"}, "revocation_id": {"$ref": "#/$defs/id"}, "record_kind": {"const": "signing_key_revocation_occurrence"}, "key_id": {"$ref": "#/$defs/uuid"}, "key_entity_ref": {"$ref": "#/$defs/entity_ref"}, "authorization_ref": {"$ref": "#/$defs/auth_ref"}, "revoked_at": {"type": "string", "format": "date-time"}, "private_material_disposition": {"const": "retained_root_only_not_exported_pending_retention_policy"}, "formal_authority": {"const": "none"}, "positive_assurance_allowed": {"const": false}, "revocation_digest": {"$ref": "#/$defs/digest"}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"}, "uuid": {"type": "string", "pattern": "^[0-9a-f-]{36}$"}, "entity_ref": {"type": "string", "pattern": "^.{1,200}・[0-9a-f-]{36}$"}, "digest": {"type": "object", "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "unevaluatedProperties": false}, "auth_ref": {"type": "object", "required": ["authorization_id", "authorization_digest"], "properties": {"authorization_id": {"$ref": "#/$defs/id"}, "authorization_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false}}, "unevaluatedProperties": false
}
