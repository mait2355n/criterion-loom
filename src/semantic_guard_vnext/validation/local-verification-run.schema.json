{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/vnext/validation/local-verification-run.schema.json",
  "title": "semantic-guard vNext legacy bound local verification run",
  "type": "object",
  "required": [
    "schema_version", "run_id", "started_at", "finished_at", "duration_seconds",
    "status", "profile", "environment", "subject", "commands", "claim_ceiling",
    "limitations", "run_record_digest"
  ],
  "properties": {
    "schema_version": {"const": "semantic-guard-local-verification-run/v0"},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "status": {"enum": ["passed", "failed", "invalid"]},
    "profile": {"$ref": "#/$defs/bound_file"},
    "environment": {"$ref": "#/$defs/bound_file"},
    "subject": {
      "allOf": [
        {"$ref": "#/$defs/bound_file"},
        {
          "type": "object",
          "required": ["manifest_id", "manifest_version", "entry_count", "identity_digest"],
          "properties": {
            "manifest_id": {"$ref": "#/$defs/stable_id"},
            "manifest_version": {"type": "string", "minLength": 1},
            "entry_count": {"type": "integer", "minimum": 1},
            "identity_digest": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "run_record_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1},
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "unevaluatedProperties": false
    },
    "bound_file": {
      "type": "object",
      "required": ["locator", "file_digest"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "file_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "raw_output": {
      "type": "object",
      "required": ["locator", "file_digest", "size_bytes", "truncated"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "file_digest": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "truncated": {"const": false}
      },
      "unevaluatedProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "command_id", "argv", "cwd", "executable", "started_at", "finished_at",
        "duration_seconds", "status", "exit_code", "timed_out",
        "pre_manifest_identity_digest", "post_manifest_identity_digest",
        "mutation_detected", "stdout", "stderr"
      ],
      "properties": {
        "command_id": {"$ref": "#/$defs/stable_id"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string", "minLength": 1},
        "executable": {
          "type": "object",
          "required": ["resolved_path", "file_digest"],
          "properties": {
            "resolved_path": {"type": "string", "minLength": 1},
            "file_digest": {"$ref": "#/$defs/digest"}
          },
          "unevaluatedProperties": false
        },
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "status": {"enum": ["passed", "failed", "timed_out", "invalid"]},
        "exit_code": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "pre_manifest_identity_digest": {"$ref": "#/$defs/digest"},
        "post_manifest_identity_digest": {"$ref": "#/$defs/digest"},
        "mutation_detected": {"type": "boolean"},
        "stdout": {"$ref": "#/$defs/raw_output"},
        "stderr": {"$ref": "#/$defs/raw_output"}
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
