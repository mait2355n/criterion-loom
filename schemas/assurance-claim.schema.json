{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/v1/schemas/assurance-claim.schema.json",
  "title": "semantic-guard v1 bounded assurance claim",
  "description": "A replayable, bounded claim. This record is not unconditional proof, execution authorization, or final acceptance.",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "subject_ref",
    "claim_kind",
    "proposition",
    "scope",
    "outcome",
    "finality",
    "challenge",
    "assurance_level",
    "interpretations",
    "rules",
    "supporting_evidence_refs",
    "challenging_evidence_refs",
    "trust_assumptions",
    "counterconditions",
    "coverage",
    "unproven_scope",
    "residual_risks",
    "holds",
    "open_hold_ids",
    "source_spans",
    "provenance",
    "authority_effects"
  ],
  "properties": {
    "schema_version": {
      "const": "assurance-claim/v0"
    },
    "claim_id": {
      "$ref": "common.schema.json#/$defs/stable_id"
    },
    "subject_ref": {
      "$ref": "common.schema.json#/$defs/entity_reference"
    },
    "claim_kind": {
      "type": "string",
      "enum": [
        "description_completeness",
        "requirement_conformance",
        "plan_traceability",
        "action_occurrence",
        "actor_identity",
        "authority",
        "procedure_conformance",
        "artifact_generation",
        "artifact_provenance",
        "verification_result",
        "validation_result",
        "authenticity",
        "causality",
        "other"
      ]
    },
    "proposition": {
      "$ref": "common.schema.json#/$defs/non_empty_string"
    },
    "scope": {
      "type": "object",
      "required": ["included_refs", "excluded_refs", "time_boundary", "environment_boundary"],
      "properties": {
        "included_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/entity_reference"}
        },
        "excluded_refs": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/entity_reference"}
        },
        "time_boundary": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        },
        "environment_boundary": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        }
      },
      "unevaluatedProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": ["satisfied", "refuted", "undetermined", "not_applicable", "invalid"]
    },
    "finality": {
      "type": "string",
      "enum": ["provisional", "terminal", "invalid"]
    },
    "challenge": {
      "type": "string",
      "enum": ["none", "open", "conflict"]
    },
    "assurance_level": {
      "type": "string",
      "enum": [
        "documented",
        "derived_under_profile",
        "corroborated",
        "verified_under_declared_scope",
        "validated_in_context",
        "formally_proved",
        "authenticated"
      ]
    },
    "assurance_mechanism_refs": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/entity_reference"}
    },
    "interpretations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/interpretation"}
    },
    "rules": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/rule_reference"}
    },
    "supporting_evidence_refs": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/entity_reference"}
    },
    "challenging_evidence_refs": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/entity_reference"}
    },
    "trust_assumptions": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "counterconditions": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/non_empty_string"},
      "uniqueItems": true
    },
    "coverage": {
      "$ref": "common.schema.json#/$defs/coverage"
    },
    "unproven_scope": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/unobserved_range"}
    },
    "residual_risks": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/residual_risk"}
    },
    "holds": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/hold"}
    },
    "open_hold_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/stable_id"},
      "uniqueItems": true
    },
    "source_spans": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/source_span"}
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/provenance_record"}
    },
    "authority_effects": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/authority_effect"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "satisfied"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {"supporting_evidence_refs": {"minItems": 1}}
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {"const": "satisfied"},
          "finality": {"const": "terminal"}
        },
        "required": ["outcome", "finality"]
      },
      "then": {
        "properties": {
          "challenge": {"const": "none"},
          "coverage": {
            "properties": {"status": {"const": "complete"}},
            "required": ["status"]
          },
          "unproven_scope": {"maxItems": 0},
          "open_hold_ids": {"maxItems": 0},
          "authority_effects": {
            "contains": {
              "properties": {"kind": {"const": "support"}},
              "required": ["kind"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "refuted"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "challenging_evidence_refs": {"minItems": 1},
          "authority_effects": {
            "contains": {
              "properties": {"kind": {"const": "challenge"}},
              "required": ["kind"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {"challenge": {"enum": ["open", "conflict"]}},
        "required": ["challenge"]
      },
      "then": {
        "properties": {
          "challenging_evidence_refs": {"minItems": 1},
          "authority_effects": {
            "contains": {
              "properties": {"kind": {"const": "challenge"}},
              "required": ["kind"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "not_applicable"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "finality": {"const": "terminal"},
          "challenge": {"const": "none"},
          "supporting_evidence_refs": {"minItems": 1},
          "coverage": {
            "properties": {"status": {"const": "complete"}},
            "required": ["status"]
          },
          "open_hold_ids": {"maxItems": 0},
          "authority_effects": {
            "contains": {
              "properties": {"kind": {"const": "support"}},
              "required": ["kind"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assurance_level": {
            "enum": ["formally_proved", "authenticated"]
          }
        },
        "required": ["assurance_level"]
      },
      "then": {
        "required": ["assurance_mechanism_refs"],
        "properties": {"assurance_mechanism_refs": {"minItems": 1}}
      }
    },
    {
      "if": {
        "properties": {
          "assurance_level": {"const": "derived_under_profile"},
          "finality": {"const": "terminal"}
        },
        "required": ["assurance_level", "finality"]
      },
      "then": {
        "properties": {
          "rules": {"minItems": 1},
          "trust_assumptions": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "undetermined"}},
        "required": ["outcome"]
      },
      "then": {
        "anyOf": [
          {"properties": {"unproven_scope": {"minItems": 1}}},
          {"properties": {"challenge": {"enum": ["open", "conflict"]}}},
          {
            "properties": {
              "coverage": {
                "properties": {"status": {"enum": ["partial", "not_evaluated", "failed"]}},
                "required": ["status"]
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "invalid"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {"finality": {"const": "invalid"}}
      }
    },
    {
      "if": {
        "properties": {"finality": {"const": "invalid"}},
        "required": ["finality"]
      },
      "then": {
        "properties": {"outcome": {"const": "invalid"}}
      }
    }
  ],
  "unevaluatedProperties": false
}
