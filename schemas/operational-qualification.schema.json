{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/v1/schemas/operational-qualification.schema.json",
  "title": "semantic-guard v1 operational qualification",
  "description": "Closed operational-qualification evidence. It reports eligibility or externally recorded human authorization only; it never deploys, schedules, accepts risk, changes defaults, or retires a predecessor.",
  "type": "object",
  "required": [
    "schema_version",
    "qualification_id",
    "qualification_version",
    "profile_ref",
    "deployment_envelope_ref",
    "scope_manifest_refs",
    "scope_digest",
    "assessed_at",
    "time_trust",
    "scenario_observations",
    "review_basis_digest",
    "independent_review_record",
    "change_assessment",
    "eligibility",
    "authorization_basis_digest",
    "human_authorization_record",
    "outcome",
    "independent_open_dimensions",
    "limitations",
    "authority_boundary",
    "qualification_digest"
  ],
  "properties": {
    "schema_version": {"const": "operational-qualification/v0"},
    "qualification_id": {"$ref": "#/$defs/stable_id"},
    "qualification_version": {"$ref": "#/$defs/non_empty_string"},
    "profile_ref": {"$ref": "#/$defs/profile_ref"},
    "deployment_envelope_ref": {"$ref": "#/$defs/envelope_ref"},
    "scope_manifest_refs": {"$ref": "#/$defs/scope_manifest_refs"},
    "scope_digest": {"$ref": "#/$defs/sha256_digest"},
    "assessed_at": {"type": "string", "format": "date-time"},
    "time_trust": {"enum": ["trusted", "untrusted"]},
    "scenario_observations": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/scenario_observation"}
    },
    "review_basis_digest": {"$ref": "#/$defs/sha256_digest"},
    "independent_review_record": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/independent_review_record"}
      ]
    },
    "change_assessment": {"$ref": "#/$defs/change_assessment"},
    "eligibility": {"$ref": "#/$defs/eligibility"},
    "authorization_basis_digest": {"$ref": "#/$defs/sha256_digest"},
    "human_authorization_record": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/external_human_decision"}
      ]
    },
    "outcome": {"enum": ["eligible", "not_eligible", "human_authorized"]},
    "independent_open_dimensions": {
      "type": "object",
      "required": ["semantic_field_validity", "security", "human_acceptance"],
      "properties": {
        "semantic_field_validity": {"const": "open"},
        "security": {"const": "open"},
        "human_acceptance": {"const": "open"}
      },
      "unevaluatedProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "authority_boundary": {"$ref": "#/$defs/authority_boundary"},
    "qualification_digest": {"$ref": "#/$defs/sha256_digest"}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "non_empty_string": {"type": "string", "minLength": 1},
    "sha256_digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "unevaluatedProperties": false
    },
    "identity_binding": {
      "type": "object",
      "required": ["entity_id", "entity_version", "content_digest"],
      "properties": {
        "entity_id": {"$ref": "#/$defs/stable_id"},
        "entity_version": {"$ref": "#/$defs/non_empty_string"},
        "content_digest": {"$ref": "#/$defs/sha256_digest"}
      },
      "unevaluatedProperties": false
    },
    "manifest_ref": {
      "type": "object",
      "required": ["manifest_id", "manifest_version", "manifest_digest"],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/stable_id"},
        "manifest_version": {"$ref": "#/$defs/non_empty_string"},
        "manifest_digest": {"$ref": "#/$defs/sha256_digest"}
      },
      "unevaluatedProperties": false
    },
    "scope_manifest_refs": {
      "type": "object",
      "required": [
        "subject_manifest_ref",
        "environment_manifest_ref",
        "dependency_manifest_ref",
        "provider_manifest_ref",
        "configuration_manifest_ref"
      ],
      "properties": {
        "subject_manifest_ref": {"$ref": "#/$defs/manifest_ref"},
        "environment_manifest_ref": {"$ref": "#/$defs/manifest_ref"},
        "dependency_manifest_ref": {"$ref": "#/$defs/manifest_ref"},
        "provider_manifest_ref": {"$ref": "#/$defs/manifest_ref"},
        "configuration_manifest_ref": {"$ref": "#/$defs/manifest_ref"}
      },
      "unevaluatedProperties": false
    },
    "external_record_ref": {
      "type": "object",
      "required": ["record_id", "locator", "content_digest"],
      "properties": {
        "record_id": {"$ref": "#/$defs/stable_id"},
        "locator": {"$ref": "#/$defs/non_empty_string"},
        "content_digest": {"$ref": "#/$defs/sha256_digest"}
      },
      "unevaluatedProperties": false
    },
    "external_human_decision": {
      "type": "object",
      "required": [
        "decision_id",
        "decision_kind",
        "decision_source",
        "actor_kind",
        "decided_by",
        "decided_at",
        "status",
        "target_id",
        "target_version",
        "target_digest",
        "trust_class",
        "record_ref"
      ],
      "properties": {
        "decision_id": {"$ref": "#/$defs/stable_id"},
        "decision_kind": {
          "enum": [
            "adopt_operational_profile",
            "retire_operational_profile",
            "select_deployment_envelope",
            "authorize_operational_use"
          ]
        },
        "decision_source": {"const": "external_human_record"},
        "actor_kind": {"const": "human"},
        "decided_by": {"$ref": "#/$defs/stable_id"},
        "decided_at": {"type": "string", "format": "date-time"},
        "status": {"const": "accepted"},
        "target_id": {"$ref": "#/$defs/stable_id"},
        "target_version": {"$ref": "#/$defs/non_empty_string"},
        "target_digest": {"$ref": "#/$defs/sha256_digest"},
        "trust_class": {"enum": ["independently_observed", "signed"]},
        "record_ref": {"$ref": "#/$defs/external_record_ref"}
      },
      "unevaluatedProperties": false
    },
    "scenario_id": {
      "enum": [
        "duration",
        "concurrency",
        "load",
        "resource_exhaustion",
        "provider_failure",
        "restart",
        "recovery",
        "compatibility",
        "platform",
        "observability",
        "incident",
        "rollback_trigger"
      ]
    },
    "scenario_threshold": {
      "type": "object",
      "required": [
        "threshold_id",
        "threshold_version",
        "scenario_id",
        "metric",
        "comparator",
        "target_value",
        "unit",
        "observation_window_seconds",
        "threshold_digest"
      ],
      "properties": {
        "threshold_id": {"$ref": "#/$defs/stable_id"},
        "threshold_version": {"$ref": "#/$defs/non_empty_string"},
        "scenario_id": {"$ref": "#/$defs/scenario_id"},
        "metric": {"$ref": "#/$defs/non_empty_string"},
        "comparator": {"enum": ["lte", "lt", "gte", "gt", "eq"]},
        "target_value": {"type": "number"},
        "unit": {"$ref": "#/$defs/non_empty_string"},
        "observation_window_seconds": {"type": "integer", "minimum": 1},
        "threshold_digest": {"$ref": "#/$defs/sha256_digest"}
      },
      "unevaluatedProperties": false
    },
    "operational_profile": {
      "type": "object",
      "required": [
        "schema_version",
        "profile_id",
        "profile_version",
        "supported_deployment_modes",
        "required_scenarios",
        "scenario_execution_policy",
        "max_evidence_age_seconds",
        "change_invalidation",
        "profile_basis_digest",
        "adoption_state",
        "adoption_decision_ref",
        "retirement_decision_ref",
        "profile_digest"
      ],
      "properties": {
        "schema_version": {"const": "operational-qualification-profile/v0"},
        "profile_id": {"$ref": "#/$defs/stable_id"},
        "profile_version": {"$ref": "#/$defs/non_empty_string"},
        "supported_deployment_modes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["local", "ci", "sidecar", "service", "external_provider"]}
        },
        "required_scenarios": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scenario_id"}
        },
        "scenario_execution_policy": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/scenario_execution_policy"}
        },
        "max_evidence_age_seconds": {"type": "integer", "minimum": 1},
        "change_invalidation": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/change_invalidation_rule"}
        },
        "profile_basis_digest": {"$ref": "#/$defs/sha256_digest"},
        "adoption_state": {"enum": ["pending", "adopted", "retired"]},
        "adoption_decision_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/external_human_decision"}]
        },
        "retirement_decision_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/external_human_decision"}]
        },
        "profile_digest": {"$ref": "#/$defs/sha256_digest"}
      },
      "unevaluatedProperties": false
    },
    "scenario_execution_policy": {
      "type": "object",
      "required": ["scenario_id", "accepted_execution_kinds", "state_transition_required"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/scenario_id"},
        "accepted_execution_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/execution_kind"}
        },
        "state_transition_required": {"type": "boolean"}
      },
      "unevaluatedProperties": false
    },
    "change_invalidation_rule": {
      "type": "object",
      "required": ["dimension", "invalidates_prior", "requires_requalification"],
      "properties": {
        "dimension": {
          "enum": ["subject", "environment", "dependency", "provider", "configuration", "profile", "envelope"]
        },
        "invalidates_prior": {"const": true},
        "requires_requalification": {"const": true}
      },
      "unevaluatedProperties": false
    },
    "profile_ref": {
      "type": "object",
      "required": ["profile_id", "profile_version", "profile_digest", "adoption_state", "adopted_at", "max_evidence_age_seconds"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/stable_id"},
        "profile_version": {"$ref": "#/$defs/non_empty_string"},
        "profile_digest": {"$ref": "#/$defs/sha256_digest"},
        "adoption_state": {"enum": ["pending", "adopted", "retired"]},
        "adopted_at": {
          "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
        },
        "max_evidence_age_seconds": {"type": "integer", "minimum": 1}
      },
      "unevaluatedProperties": false
    },
    "deployment_envelope": {
      "type": "object",
      "required": [
        "schema_version",
        "envelope_id",
        "envelope_version",
        "profile_ref",
        "selected_mode",
        "platform_manifest_ref",
        "scenario_thresholds",
        "envelope_basis_digest",
        "selection_state",
        "selection_decision_ref",
        "envelope_digest"
      ],
      "properties": {
        "schema_version": {"const": "deployment-envelope/v0"},
        "envelope_id": {"$ref": "#/$defs/stable_id"},
        "envelope_version": {"$ref": "#/$defs/non_empty_string"},
        "profile_ref": {"$ref": "#/$defs/profile_ref"},
        "selected_mode": {"enum": ["local", "ci", "sidecar", "service", "external_provider"]},
        "platform_manifest_ref": {"$ref": "#/$defs/manifest_ref"},
        "scenario_thresholds": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/scenario_threshold"}
        },
        "envelope_basis_digest": {"$ref": "#/$defs/sha256_digest"},
        "selection_state": {"enum": ["pending", "selected"]},
        "selection_decision_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/external_human_decision"}]
        },
        "envelope_digest": {"$ref": "#/$defs/sha256_digest"}
      },
      "unevaluatedProperties": false
    },
    "envelope_ref": {
      "type": "object",
      "required": ["envelope_id", "envelope_version", "envelope_digest", "selected_mode", "selection_state", "selected_at"],
      "properties": {
        "envelope_id": {"$ref": "#/$defs/stable_id"},
        "envelope_version": {"$ref": "#/$defs/non_empty_string"},
        "envelope_digest": {"$ref": "#/$defs/sha256_digest"},
        "selected_mode": {"enum": ["local", "ci", "sidecar", "service", "external_provider"]},
        "selection_state": {"enum": ["pending", "selected"]},
        "selected_at": {
          "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
        }
      },
      "unevaluatedProperties": false
    },
    "execution_kind": {
      "enum": [
        "unit_test",
        "schema_test",
        "smoke_test",
        "soak_test",
        "concurrency_test",
        "load_test",
        "resource_exhaustion_test",
        "fault_injection",
        "restart_rehearsal",
        "recovery_rehearsal",
        "compatibility_test",
        "platform_test",
        "observability_test",
        "incident_rehearsal",
        "rollback_rehearsal",
        "production_observation"
      ]
    },
    "raw_evidence_ref": {
      "type": "object",
      "required": ["evidence_id", "locator", "evidence_kind", "content_digest"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/stable_id"},
        "locator": {"$ref": "#/$defs/non_empty_string"},
        "evidence_kind": {
          "enum": ["execution_log", "metric_series", "trace", "incident_record", "recovery_record", "compatibility_report", "review_record", "other"]
        },
        "content_digest": {"$ref": "#/$defs/sha256_digest"}
      },
      "unevaluatedProperties": false
    },
    "threshold_ref": {
      "type": "object",
      "required": ["threshold_id", "threshold_version", "threshold_digest"],
      "properties": {
        "threshold_id": {"$ref": "#/$defs/stable_id"},
        "threshold_version": {"$ref": "#/$defs/non_empty_string"},
        "threshold_digest": {"$ref": "#/$defs/sha256_digest"}
      },
      "unevaluatedProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["value", "unit", "comparator", "threshold_met"],
      "properties": {
        "value": {"oneOf": [{"type": "number"}, {"type": "null"}]},
        "unit": {"$ref": "#/$defs/non_empty_string"},
        "comparator": {"enum": ["lte", "lt", "gte", "gt", "eq"]},
        "threshold_met": {"type": "boolean"}
      },
      "unevaluatedProperties": false
    },
    "scenario_observation": {
      "type": "object",
      "required": [
        "schema_version",
        "observation_id",
        "execution_id",
        "scenario_id",
        "execution_kind",
        "evidence_origin",
        "status",
        "observed_at",
        "expires_at",
        "time_trust",
        "deployment_mode",
        "platform_manifest_ref",
        "scope_digest",
        "envelope_ref",
        "threshold_ref",
        "measurement",
        "executor_ref",
        "raw_evidence_refs",
        "before_state_digest",
        "after_state_digest",
        "limitations",
        "observation_digest"
      ],
      "properties": {
        "schema_version": {"const": "operational-scenario-observation/v0"},
        "observation_id": {"$ref": "#/$defs/stable_id"},
        "execution_id": {"$ref": "#/$defs/stable_id"},
        "scenario_id": {"$ref": "#/$defs/scenario_id"},
        "execution_kind": {"$ref": "#/$defs/execution_kind"},
        "evidence_origin": {"enum": ["synthetic_fixture", "controlled_execution", "operational_observation"]},
        "status": {"enum": ["passed", "failed", "not_run", "out_of_scope"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "time_trust": {"enum": ["trusted", "untrusted"]},
        "deployment_mode": {"enum": ["local", "ci", "sidecar", "service", "external_provider"]},
        "platform_manifest_ref": {"$ref": "#/$defs/manifest_ref"},
        "scope_digest": {"$ref": "#/$defs/sha256_digest"},
        "envelope_ref": {"$ref": "#/$defs/envelope_ref"},
        "threshold_ref": {"$ref": "#/$defs/threshold_ref"},
        "measurement": {"$ref": "#/$defs/measurement"},
        "executor_ref": {"$ref": "#/$defs/identity_binding"},
        "raw_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/raw_evidence_ref"}
        },
        "before_state_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256_digest"}]
        },
        "after_state_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256_digest"}]
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "observation_digest": {"$ref": "#/$defs/sha256_digest"}
      },
      "unevaluatedProperties": false
    },
    "independent_review_record": {
      "type": "object",
      "required": [
        "schema_version",
        "review_id",
        "review_source",
        "reviewer_ref",
        "reviewed_at",
        "status",
        "target_qualification_id",
        "target_qualification_version",
        "target_basis_digest",
        "trust_class",
        "raw_evidence_refs",
        "review_digest"
      ],
      "properties": {
        "schema_version": {"const": "independent-operational-review/v0"},
        "review_id": {"$ref": "#/$defs/stable_id"},
        "review_source": {"const": "external_independent_record"},
        "reviewer_ref": {"$ref": "#/$defs/identity_binding"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["accepted", "rejected", "inconclusive"]},
        "target_qualification_id": {"$ref": "#/$defs/stable_id"},
        "target_qualification_version": {"$ref": "#/$defs/non_empty_string"},
        "target_basis_digest": {"$ref": "#/$defs/sha256_digest"},
        "trust_class": {"enum": ["independently_observed", "signed"]},
        "raw_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/raw_evidence_ref"}
        },
        "review_digest": {"$ref": "#/$defs/sha256_digest"}
      },
      "unevaluatedProperties": false
    },
    "qualification_ref": {
      "type": "object",
      "required": ["qualification_id", "qualification_version", "qualification_digest", "scope_digest", "profile_ref", "deployment_envelope_ref"],
      "properties": {
        "qualification_id": {"$ref": "#/$defs/stable_id"},
        "qualification_version": {"$ref": "#/$defs/non_empty_string"},
        "qualification_digest": {"$ref": "#/$defs/sha256_digest"},
        "scope_digest": {"$ref": "#/$defs/sha256_digest"},
        "profile_ref": {"$ref": "#/$defs/profile_ref"},
        "deployment_envelope_ref": {"$ref": "#/$defs/envelope_ref"}
      },
      "unevaluatedProperties": false
    },
    "change_assessment": {
      "type": "object",
      "required": ["prior_qualification_ref", "changed_dimensions", "prior_invalidated", "requalification_required", "replayed_execution_ids", "replayed_evidence_digests"],
      "properties": {
        "prior_qualification_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/qualification_ref"}]
        },
        "changed_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["subject", "environment", "dependency", "provider", "configuration", "profile", "envelope"]}
        },
        "prior_invalidated": {"type": "boolean"},
        "requalification_required": {"type": "boolean"},
        "replayed_execution_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        },
        "replayed_evidence_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "unevaluatedProperties": false
    },
    "eligibility": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": {"enum": ["eligible", "not_eligible"]},
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        }
      },
      "unevaluatedProperties": false
    },
    "authority_boundary": {
      "type": "object",
      "required": ["semantic_guard_role", "deploy", "schedule", "change_default", "accept_risk", "retire", "final_decision_owner"],
      "properties": {
        "semantic_guard_role": {"const": "audit_operational_qualification_only"},
        "deploy": {"const": false},
        "schedule": {"const": false},
        "change_default": {"const": false},
        "accept_risk": {"const": false},
        "retire": {"const": false},
        "final_decision_owner": {"const": "human"}
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
