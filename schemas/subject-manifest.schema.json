{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/v1/schemas/subject-manifest.schema.json",
  "title": "semantic-guard v1 closed-world subject manifest",
  "description": "Digest-bound denominator for the exact subject, environment, and profile assessed by a state assessment. Closure is only over declared entries; it is not proof that the chosen real-world denominator is complete.",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "denominator",
    "subject_entries",
    "environment_bindings",
    "profile_bindings",
    "manifest_digest"
  ],
  "properties": {
    "schema_version": {"const": "subject-manifest/v0"},
    "manifest_id": {"$ref": "#/$defs/stable_id"},
    "manifest_version": {"type": "string", "minLength": 1},
    "denominator": {
      "type": "object",
      "required": [
        "status",
        "root",
        "inclusion_rule",
        "exclusions",
        "subject_entry_count"
      ],
      "properties": {
        "status": {"const": "closed"},
        "root": {"$ref": "#/$defs/repository_path"},
        "inclusion_rule": {"type": "string", "minLength": 1},
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason"],
            "properties": {
              "path": {"$ref": "#/$defs/repository_path"},
              "reason": {"type": "string", "minLength": 1}
            },
            "unevaluatedProperties": false
          }
        },
        "subject_entry_count": {"type": "integer", "minimum": 1}
      },
      "unevaluatedProperties": false
    },
    "subject_entries": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {"role": {"const": "primary_subject"}},
        "required": ["role"]
      },
      "items": {
        "type": "object",
        "required": ["entry_id", "path", "role", "content_digest"],
        "properties": {
          "entry_id": {"$ref": "#/$defs/stable_id"},
          "path": {"$ref": "#/$defs/repository_path"},
          "role": {
            "enum": [
              "primary_subject",
              "component",
              "configuration",
              "dependency",
              "evidence"
            ]
          },
          "content_digest": {"$ref": "#/$defs/sha256_digest"}
        },
        "unevaluatedProperties": false
      }
    },
    "environment_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/identity_binding"}
    },
    "profile_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/identity_binding"}
    },
    "manifest_digest": {"$ref": "#/$defs/sha256_digest"}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "sha256_digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "unevaluatedProperties": false
    },
    "identity_binding": {
      "type": "object",
      "required": ["entity_id", "entity_version", "content_digest"],
      "properties": {
        "entity_id": {"$ref": "#/$defs/stable_id"},
        "entity_version": {"type": "string", "minLength": 1},
        "content_digest": {"$ref": "#/$defs/sha256_digest"}
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
