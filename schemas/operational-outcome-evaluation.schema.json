        }
      }
    },
    "armMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_count",
        "participant_count",
        "cluster_count",
        "analysis_unit",
        "metric_rates",
        "weighted_error_loss",
        "effort_seconds",
        "effort_units",
        "enrollment",
        "stratum_counts"
      ],
      "properties": {
        "observation_count": {"type": "integer", "minimum": 0},
        "participant_count": {"type": "integer", "minimum": 0},
        "cluster_count": {"type": "integer", "minimum": 0},
        "analysis_unit": {"const": "participant_cluster"},
        "metric_rates": {
          "type": "array",
          "minItems": 5,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/metricRate"}
        },
        "weighted_error_loss": {"$ref": "#/$defs/boundedMean"},
        "effort_seconds": {"$ref": "#/$defs/boundedMean"},
        "effort_units": {"$ref": "#/$defs/boundedMean"},
        "enrollment": {"$ref": "#/$defs/enrollmentSummary"},
        "stratum_counts": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/stratumCount"}
        }
      }
    },
    "thresholdCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "metric_id",
        "observed",
        "threshold",
        "comparison",
        "basis",
        "passed"
      ],
      "properties": {
        "criterion": {
          "enum": [
            "error_rate_wilson_upper",
            "success_rate_wilson_lower",
            "weighted_error_loss_upper",
            "weighted_loss_improvement_lower",
            "effort_seconds_upper",
            "effort_units_upper",
            "baseline_dropout_rate_wilson_upper",
            "candidate_dropout_rate_wilson_upper"
          ]
        },
        "metric_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/metricId"}
          ]
        },
        "observed": {"type": "number"},
        "threshold": {"type": "number"},
        "comparison": {"enum": ["less_than_or_equal", "greater_than_or_equal"]},
        "basis": {
          "enum": [
            "wilson_upper_bound",
            "wilson_lower_bound",
            "hoeffding_upper_bound",
            "baseline_hoeffding_lower_minus_candidate_hoeffding_upper"
          ]
        },
        "passed": {"type": "boolean"}
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "metric_id",
        "score_refs",
        "adjudication_ref",
        "resolved_result"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/nonEmptyString"},
        "metric_id": {"$ref": "#/$defs/metricId"},
        "score_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "adjudication_ref": {"$ref": "#/$defs/nonEmptyString"},
        "resolved_result": {"type": "boolean"}
      }
    },
    "axisResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "status",
        "claim_scope",
        "task_set_digest",
        "arm_metrics",
        "unpaired_arm_comparison",
        "threshold_assessment",
        "disagreements",
        "reasons",
        "limitations",
        "cross_axis_inference_prohibited",
        "result_digest"
      ],
      "properties": {
        "axis": {"$ref": "#/$defs/axis"},
        "status": {"enum": ["meets_policy_for_declared_records", "not_established"]},
        "claim_scope": {
          "enum": [
            "declared_records_only",
            "declared_synthetic_protocol_only",
            "declared_protocol_not_established"
          ]
        },
        "task_set_digest": {"$ref": "#/$defs/digest"},
        "arm_metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "candidate"],
          "properties": {
            "baseline": {"$ref": "#/$defs/armMetrics"},
            "candidate": {"$ref": "#/$defs/armMetrics"}
          }
        },
        "unpaired_arm_comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_weighted_loss_lower",
            "candidate_weighted_loss_upper",
            "improvement_lower",
            "minimum_required_improvement",
            "basis",
            "passed"
          ],
          "properties": {
            "baseline_weighted_loss_lower": {"type": "number", "minimum": 0},
            "candidate_weighted_loss_upper": {"type": "number", "minimum": 0},
            "improvement_lower": {"type": "number"},
            "minimum_required_improvement": {"type": "number"},
            "basis": {"const": "baseline_hoeffding_lower_minus_candidate_hoeffding_upper"},
            "passed": {"type": "boolean"}
          }
        },
        "threshold_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "criteria", "confidence_level"],
          "properties": {
            "status": {"enum": ["passed", "failed"]},
            "criteria": {
              "type": "array",
              "minItems": 18,
              "maxItems": 64,
              "items": {"$ref": "#/$defs/thresholdCriterion"}
            },
            "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
          }
        },
        "disagreements": {
          "type": "array",
          "maxItems": 65536,
          "items": {"$ref": "#/$defs/disagreement"}
        },
        "reasons": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "limitations": {"$ref": "#/$defs/nonEmptyStrings"},
        "cross_axis_inference_prohibited": {"const": true},
        "result_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "nonInferenceValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "not_evaluated"},
        "reason": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "nonInferenceAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_validity",
        "operational_qualification",
        "security",
        "cutover",
        "final_acceptance"
      ],
      "properties": {
        "field_validity": {"$ref": "#/$defs/nonInferenceValue"},
        "operational_qualification": {"$ref": "#/$defs/nonInferenceValue"},
        "security": {"$ref": "#/$defs/nonInferenceValue"},
        "cutover": {"$ref": "#/$defs/nonInferenceValue"},
        "final_acceptance": {"$ref": "#/$defs/nonInferenceValue"}
      }
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_guard_role",
        "participant_assignment",
        "work_routing",
        "repair_execution",
        "authority_grant",
        "question_sending",
        "policy_adoption",
        "cutover_decision",
        "final_acceptance",
        "external_owners"
      ],
      "properties": {
        "semantic_guard_role": {"const": "compute_and_validate_audit_material_only"},
        "participant_assignment": {"const": false},
        "work_routing": {"const": false},
        "repair_execution": {"const": false},
        "authority_grant": {"const": false},
        "question_sending": {"const": false},
        "policy_adoption": {"const": false},
        "cutover_decision": {"const": false},
        "final_acceptance": {"const": false},
        "external_owners": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "study_operation",
            "control",
            "policy_and_thresholds",
            "final_acceptance"
          ],
          "properties": {
            "study_operation": {"const": "external_research_or_operations_owner"},
            "control": {"const": "external_caller_or_resource_control_plane"},
            "policy_and_thresholds": {"const": "human"},
            "final_acceptance": {"const": "human"}
          }
        }
      }
    }
  }
}
