      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "mean",
        "lower",
        "upper",
        "cap",
        "confidence",
        "basis"
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "mean": {"type": ["number", "null"], "minimum": 0},
        "lower": {"type": ["number", "null"], "minimum": 0},
        "upper": {"type": ["number", "null"], "minimum": 0},
        "cap": {"type": "number", "exclusiveMinimum": 0},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "basis": {"const": "two_sided_hoeffding_bound"}
      }
