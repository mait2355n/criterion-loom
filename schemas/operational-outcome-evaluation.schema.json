        "success_rate",
        "error_rate"
      ],
      "properties": {
        "metric_id": {"$ref": "#/$defs/metricId"},
        "success_count": {"type": "integer", "minimum": 0},
        "error_count": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0},
