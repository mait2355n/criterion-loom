{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/v1/schemas/operational-outcome-evaluation.schema.json",
  "title": "semantic-guard operational outcome evaluation bundle",
  "description": "A closed, content-addressed contract for separate repair-effect and human-operational-use evaluation. It does not establish field validity, operation, security, cutover, or final acceptance. The Python validator also rejects input nesting deeper than 128 levels before schema evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "policy",
    "human_decision_records",
    "task_set",
    "enrollment_manifest",
    "tasks",
    "participants",
    "sessions",
    "observations",
    "graders",
    "scores",
    "adjudications",
    "axis_results",
    "non_inference_axes",
    "authority_boundary",
    "limitations",
    "bundle_digest"
  ],
  "properties": {
    "schema_version": {"const": "operational-outcome-evaluation/v1"},
    "evaluation_id": {
      "type": "string",
      "pattern": "^operational-outcome-evaluation\\.[0-9a-f]{64}$",
      "maxLength": 128
    },
    "policy": {"$ref": "#/$defs/policy"},
    "human_decision_records": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/humanDecision"}
    },
    "task_set": {"$ref": "#/$defs/taskSet"},
    "enrollment_manifest": {"$ref": "#/$defs/enrollmentManifest"},
    "tasks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/task"},
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["axis"],
            "properties": {"axis": {"const": "repair_effect"}}
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["axis"],
            "properties": {"axis": {"const": "human_operational_use"}}
          },
          "minContains": 1
        }
      ]
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2048,
      "items": {"$ref": "#/$defs/participant"}
    },
    "sessions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/session"}
    },
    "observations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 65536,
      "items": {"$ref": "#/$defs/observation"},
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["axis", "arm"],
            "properties": {
              "axis": {"const": "repair_effect"},
              "arm": {"const": "baseline"}
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["axis", "arm"],
            "properties": {
              "axis": {"const": "repair_effect"},
              "arm": {"const": "candidate"}
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["axis", "arm"],
            "properties": {
              "axis": {"const": "human_operational_use"},
              "arm": {"const": "baseline"}
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["axis", "arm"],
            "properties": {
              "axis": {"const": "human_operational_use"},
              "arm": {"const": "candidate"}
            }
          },
          "minContains": 1
        }
      ]
    },
    "graders": {
      "type": "array",
      "minItems": 3,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/grader"}
    },
    "scores": {
      "type": "array",
      "minItems": 8,
      "maxItems": 262144,
      "items": {"$ref": "#/$defs/score"}
    },
    "adjudications": {
      "type": "array",
      "maxItems": 65536,
      "items": {"$ref": "#/$defs/adjudication"}
    },
    "axis_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repair_effect", "human_operational_use"],
      "properties": {
        "repair_effect": {"$ref": "#/$defs/axisResult"},
        "human_operational_use": {"$ref": "#/$defs/axisResult"}
      }
    },
    "non_inference_axes": {"$ref": "#/$defs/nonInferenceAxes"},
    "authority_boundary": {"$ref": "#/$defs/authorityBoundary"},
    "limitations": {"$ref": "#/$defs/nonEmptyStrings"},
    "bundle_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "maxLength": 4096},
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "idStrings": {
      "type": "array",
      "maxItems": 65536,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64}
      }
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "digest"],
      "properties": {
        "ref_id": {"$ref": "#/$defs/nonEmptyString"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "nullableDigestRef": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digestRef"}
      ]
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "version", "digest"],
      "properties": {
        "ref_id": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nonEmptyString"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "axis": {
      "enum": ["repair_effect", "human_operational_use"]
    },
    "arm": {"enum": ["baseline", "candidate"]},
    "metricId": {
      "enum": [
        "correct_repair",
        "regression_free",
        "finding_integrity_preserved",
        "correct_escalation",
        "unresolved_preserved",
        "responsibility_boundary_preserved",
        "correct_routing",
        "proposition_understood",
        "evidence_understood",
        "limitations_understood",
        "unresolved_understood",
        "actionable",
        "authority_safe",
        "technical_pass_not_converted_to_acceptance"
      ]
    },
    "humanDecisionRight": {
      "enum": [
        "change_intent_or_scope",
        "accept_residual_risk",
        "grant_or_expand_authority",
        "authorize_external_effect",
        "final_acceptance"
      ]
    },
    "targetPopulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id",
        "description",
        "sampling_frame",
        "unit_of_analysis",
        "inclusion_criteria",
        "exclusion_criteria",
        "population_digest"
      ],
      "properties": {
        "population_id": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "sampling_frame": {"$ref": "#/$defs/nonEmptyString"},
        "unit_of_analysis": {"$ref": "#/$defs/nonEmptyString"},
        "inclusion_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
        "exclusion_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
        "population_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "intendedUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_id", "description", "operational_context"],
      "properties": {
        "use_id": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "operational_context": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "actor_class", "description"],
      "properties": {
        "role_id": {"$ref": "#/$defs/nonEmptyString"},
        "actor_class": {
          "enum": [
            "coding_agent",
            "human_requester",
            "human_reviewer",
            "human_approver",
            "maintainer",
            "operator"
          ]
        },
        "description": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "taskStratum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stratum_id", "axis", "description", "required"],
      "properties": {
        "stratum_id": {"$ref": "#/$defs/nonEmptyString"},
        "axis": {"$ref": "#/$defs/axis"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "required": {"type": "boolean"}
      }
    },
    "metricThreshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "max_error_rate",
        "min_success_rate",
        "error_cost"
      ],
      "properties": {
        "metric_id": {"$ref": "#/$defs/metricId"},
        "max_error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "min_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "error_cost": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000}
      }
    },
    "axisPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "metric_thresholds",
        "max_weighted_error_loss",
        "min_weighted_loss_improvement",
        "effort_cap_seconds",
        "effort_cap_units",
        "max_effort_seconds",
        "max_effort_units",
        "max_dropout_rate"
      ],
      "properties": {
        "axis": {"$ref": "#/$defs/axis"},
        "metric_thresholds": {
          "type": "array",
          "minItems": 5,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/metricThreshold"}
        },
        "max_weighted_error_loss": {"type": "number", "minimum": 0, "maximum": 1000000},
        "min_weighted_loss_improvement": {"type": "number", "minimum": -1000000, "maximum": 1000000},
        "effort_cap_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000000},
        "effort_cap_units": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000000},
        "max_effort_seconds": {"type": "number", "minimum": 0, "maximum": 10000000},
        "max_effort_units": {"type": "number", "minimum": 0, "maximum": 10000000},
        "max_dropout_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "privacyConsent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pseudonymization_required",
        "raw_identifiers_prohibited",
        "required_consent_scope",
        "consent_scope_ref",
        "data_use_limitations",
        "retention_policy",
        "withdrawal_handling",
        "privacy_owner"
      ],
      "properties": {
        "pseudonymization_required": {"const": true},
        "raw_identifiers_prohibited": {"const": true},
        "required_consent_scope": {"$ref": "#/$defs/nonEmptyString"},
        "consent_scope_ref": {"$ref": "#/$defs/versionedRef"},
        "data_use_limitations": {"$ref": "#/$defs/nonEmptyStrings"},
        "retention_policy": {"$ref": "#/$defs/nonEmptyString"},
        "withdrawal_handling": {"$ref": "#/$defs/nonEmptyString"},
        "privacy_owner": {"const": "external_human_or_organization"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "version",
        "owner_kind",
        "status",
        "decision_record_ref",
        "evidence_class",
        "target_population",
        "intended_use",
        "roles",
        "task_strata",
        "arm_contract",
        "axis_policies",
        "confidence_level",
        "minimum_sample",
        "privacy_consent",
        "stop_conditions",
        "policy_digest"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^outcome-policy\\.[a-z0-9.-]+$",
          "maxLength": 512
        },
        "version": {"$ref": "#/$defs/nonEmptyString"},
        "owner_kind": {"const": "human"},
        "status": {"enum": ["pending", "adopted", "retired"]},
        "decision_record_ref": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 512
        },
        "evidence_class": {
          "enum": [
            "operational_participant",
            "synthetic",
            "local_fixture",
            "smoke"
          ]
        },
        "target_population": {"$ref": "#/$defs/targetPopulation"},
        "intended_use": {"$ref": "#/$defs/intendedUse"},
        "roles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/role"}
        },
        "task_strata": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/taskStratum"}
        },
        "arm_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "candidate",
            "same_task_set_required",
            "cross_arm_participant_reuse_prohibited"
          ],
          "properties": {
            "baseline": {"$ref": "#/$defs/versionedRef"},
            "candidate": {"$ref": "#/$defs/versionedRef"},
            "same_task_set_required": {"const": true},
            "cross_arm_participant_reuse_prohibited": {"const": true}
          }
        },
        "axis_policies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/axisPolicy"}
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "minimum_sample": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "per_axis_arm_observations",
            "per_axis_arm_participants",
            "per_axis_arm_clusters",
            "per_required_stratum_participants"
          ],
          "properties": {
            "per_axis_arm_observations": {"type": "integer", "minimum": 1, "maximum": 65536},
            "per_axis_arm_participants": {"type": "integer", "minimum": 1, "maximum": 2048},
            "per_axis_arm_clusters": {"type": "integer", "minimum": 1, "maximum": 2048},
            "per_required_stratum_participants": {"type": "integer", "minimum": 1, "maximum": 2048}
          }
        },
        "privacy_consent": {"$ref": "#/$defs/privacyConsent"},
        "stop_conditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "policy_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "humanDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision_type",
        "issuer_kind",
        "human_actor_ref",
        "policy_ref",
        "decision",
        "rationale",
        "evidence_refs",
        "recorded_at",
        "decision_digest"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^human-decision\\.[a-z0-9.-]+$",
          "maxLength": 512
        },
        "decision_type": {"enum": ["adopt_policy", "retire_policy"]},
        "issuer_kind": {"const": "human"},
        "human_actor_ref": {"$ref": "#/$defs/nonEmptyString"},
        "policy_ref": {"$ref": "#/$defs/versionedRef"},
        "decision": {"enum": ["adopt", "retire"]},
        "rationale": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/digestRef"}
        },
        "recorded_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "decision_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "taskRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_digest"],
      "properties": {
        "task_id": {"$ref": "#/$defs/nonEmptyString"},
        "task_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "decisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision_digest"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/nonEmptyString"},
        "decision_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "nullableDecisionRef": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/decisionRef"}
      ]
    },
    "taskSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_set_id",
        "policy_ref",
        "adoption_decision_ref",
        "sealed_at",
        "task_refs",
        "task_set_digest"
      ],
      "properties": {
        "task_set_id": {
          "type": "string",
          "pattern": "^outcome-task-set\\.[a-z0-9.-]+$",
          "maxLength": 512
        },
        "policy_ref": {"$ref": "#/$defs/versionedRef"},
        "adoption_decision_ref": {"$ref": "#/$defs/nullableDecisionRef"},
        "sealed_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "task_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/taskRef"}
        },
        "task_set_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "enrollmentParticipantRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "enrollment_digest",
        "role_id",
        "arm",
        "cluster_id"
      ],
      "properties": {
        "participant_id": {"$ref": "#/$defs/nonEmptyString"},
        "enrollment_digest": {"$ref": "#/$defs/digest"},
        "role_id": {"$ref": "#/$defs/nonEmptyString"},
        "arm": {"$ref": "#/$defs/arm"},
        "cluster_id": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "enrollmentManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "policy_ref",
        "task_set_digest",
        "sealed_at",
        "participant_refs",
        "manifest_digest"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "pattern": "^outcome-enrollment\\.[a-z0-9.-]+$",
          "maxLength": 512
        },
        "policy_ref": {"$ref": "#/$defs/versionedRef"},
        "task_set_digest": {"$ref": "#/$defs/digest"},
        "sealed_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "participant_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2048,
          "items": {"$ref": "#/$defs/enrollmentParticipantRef"}
        },
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "armMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_ref", "derived_from_arm_ref"],
      "properties": {
        "material_ref": {"$ref": "#/$defs/versionedRef"},
        "derived_from_arm_ref": {"$ref": "#/$defs/versionedRef"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "axis",
        "target_role_id",
        "stratum_id",
        "correct_answer_ref",
        "rubric_ref",
        "arm_materials",
        "prohibited_decisions",
        "required_escalation",
        "unresolved_must_be_preserved",
        "prohibited_repair_shortcuts",
        "sealed_at",
        "task_digest"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^outcome-task\\.[a-z0-9.-]+$",
          "maxLength": 512
        },
        "axis": {"$ref": "#/$defs/axis"},
        "target_role_id": {"$ref": "#/$defs/nonEmptyString"},
        "stratum_id": {"$ref": "#/$defs/nonEmptyString"},
        "correct_answer_ref": {"$ref": "#/$defs/versionedRef"},
        "rubric_ref": {"$ref": "#/$defs/versionedRef"},
        "arm_materials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "candidate"],
          "properties": {
            "baseline": {"$ref": "#/$defs/armMaterial"},
            "candidate": {"$ref": "#/$defs/armMaterial"}
          }
        },
        "prohibited_decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/humanDecisionRight"}
        },
        "required_escalation": {"type": "boolean"},
        "unresolved_must_be_preserved": {"type": "boolean"},
        "prohibited_repair_shortcuts": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "finding_suppression",
              "rule_weakening",
              "verification_bypass"
            ]
          }
        },
        "sealed_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "task_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ref", "scope_ref", "recorded_at"],
      "properties": {
        "status": {"enum": ["obtained", "not_obtained", "withdrawn"]},
        "evidence_ref": {"$ref": "#/$defs/digestRef"},
        "scope_ref": {"$ref": "#/$defs/versionedRef"},
        "recorded_at": {"type": "string", "format": "date-time", "maxLength": 64}
      }
    },
    "participantDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "evidence_ref", "recorded_at"],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "withdrawn",
            "protocol_violation",
            "missing",
            "excluded"
          ]
        },
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_ref": {"$ref": "#/$defs/nullableDigestRef"},
        "recorded_at": {"type": "string", "format": "date-time", "maxLength": 64}
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "pseudonymized",
        "raw_identifiers_present",
        "role_id",
        "population_id",
        "assigned_arm",
        "cluster_id",
        "source_kind",
        "enrolled_at",
        "consent",
        "enrollment_digest",
        "disposition",
        "participant_digest"
      ],
      "properties": {
        "participant_id": {
          "type": "string",
          "pattern": "^participant-pseudo\\.[a-z0-9.-]+$",
          "maxLength": 512
        },
        "pseudonymized": {"const": true},
        "raw_identifiers_present": {"const": false},
        "role_id": {"$ref": "#/$defs/nonEmptyString"},
        "population_id": {"$ref": "#/$defs/nonEmptyString"},
        "assigned_arm": {"$ref": "#/$defs/arm"},
        "cluster_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_kind": {
          "enum": [
            "operational_participant",
            "synthetic",
            "local_fixture",
            "smoke"
          ]
        },
