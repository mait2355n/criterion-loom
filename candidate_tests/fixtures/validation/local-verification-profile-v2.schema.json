{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/vnext/validation/local-verification-profile-v2.schema.json",
  "title": "semantic-guard vNext local verification capture profile v2",
  "type": "object",
  "required": [
    "schema_version", "profile_id", "profile_version", "repository_root",
    "capture", "environment", "commands", "claims", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "semantic-guard-local-verification-profile/v2"},
    "profile_id": {"$ref": "#/$defs/stable_id"},
    "profile_version": {"type": "string", "minLength": 1},
    "repository_root": {"const": "."},
    "capture": {
      "type": "object",
      "required": [
        "inclusion_rule", "excluded_roots", "excluded_directory_names",
        "excluded_file_names", "max_files", "max_file_bytes"
      ],
      "properties": {
        "inclusion_rule": {"type": "string", "minLength": 1},
        "excluded_roots": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
        "excluded_directory_names": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
          "uniqueItems": true
        },
        "excluded_file_names": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
          "uniqueItems": true
        },
        "max_files": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      },
      "unevaluatedProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["inherit_names", "fixed_values"],
      "properties": {
        "inherit_names": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
          "uniqueItems": true
        },
        "fixed_values": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        }
      },
      "unevaluatedProperties": false
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command_id", "cwd", "argv", "timeout_seconds", "artifact_effect"],
        "properties": {
          "command_id": {"$ref": "#/$defs/stable_id"},
          "cwd": {"$ref": "#/$defs/repository_path"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 1800},
          "artifact_effect": {"enum": ["none", "may_add"]}
        },
        "unevaluatedProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "required_command_ids"],
        "properties": {
          "claim_id": {"$ref": "#/$defs/stable_id"},
          "required_command_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/stable_id"},
            "uniqueItems": true
          }
        },
        "unevaluatedProperties": false
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+)$"
    },
    "exclusion": {
      "type": "object",
      "required": ["path", "reason"],
      "properties": {
        "path": {"$ref": "#/$defs/repository_path"},
        "reason": {"type": "string", "minLength": 1}
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
