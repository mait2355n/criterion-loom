{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/vnext/schemas/u10-snapshot-projection-receipt-v1.schema.json",
  "title": "U-10 inactive snapshot projection occurrence receipt v1",
  "type": "object",
  "required": ["schema_version", "receipt_id", "record_kind", "public_operation", "public_identifier", "occurrence_id", "authorization_ref", "consumption_ref", "bundle_ref", "snapshot_ref", "dependency_lock_check", "environment_projection_check", "projected_environment_basis", "artifact_denominator", "tree_digest", "snapshot_basis_digest", "immutability_verified_at", "publication_not_before", "projection_observed_at", "receipt_recorded_at", "publisher_contract_binding", "projection_occurred", "snapshot_manifest_published", "snapshot_adoption_status", "formal_authority", "positive_assurance_allowed", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "semantic-guard-u10-snapshot-projection-receipt/v1"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "record_kind": {"const": "inactive_snapshot_projection_occurrence"},
    "public_operation": {"const": "project-snapshot"},
    "public_identifier": {"$ref": "#/$defs/id"},
    "occurrence_id": {"$ref": "#/$defs/id"},
    "authorization_ref": {"$ref": "#/$defs/ref"},
    "consumption_ref": {"type": "object", "required": ["consumption_id", "consumption_digest"], "properties": {"consumption_id": {"$ref": "#/$defs/id"}, "consumption_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false},
    "bundle_ref": {"type": "object"},
    "snapshot_ref": {"type": "object", "required": ["snapshot_id", "snapshot_version", "snapshot_path", "entry_id"], "properties": {"snapshot_id": {"$ref": "#/$defs/id"}, "snapshot_version": {"type": "string"}, "snapshot_path": {"type": "string", "pattern": "^/"}, "entry_id": {"$ref": "#/$defs/id"}}, "unevaluatedProperties": false},
    "dependency_lock_check": {"type": "object", "required": ["profile", "argv", "effective_environment", "worker_identity", "started_at", "finished_at", "exit_code", "stdout_digest", "stderr_digest"], "properties": {"profile": {"const": "uv-sync-check-offline-frozen-final-path/v1"}, "argv": {"type": "array", "minItems": 6, "items": {"type": "string"}}, "effective_environment": {"type": "object"}, "worker_identity": {"type": "object"}, "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"}, "exit_code": {"const": 0}, "stdout_digest": {"$ref": "#/$defs/digest"}, "stderr_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false},
    "environment_projection_check": {
      "type": "object",
      "required": ["profile", "argv", "effective_environment", "worker_identity", "started_at", "finished_at", "exit_code", "stdout_digest", "stderr_digest"],
      "properties": {
        "profile": {"const": "non-root-final-path-environment-projection/v1"},
        "argv": {"type": "array", "minItems": 6, "items": {"type": "string"}},
        "effective_environment": {"type": "object"},
        "worker_identity": {"type": "object"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "exit_code": {"const": 0},
        "stdout_digest": {"$ref": "#/$defs/digest"},
        "stderr_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    },
    "projected_environment_basis": {
      "type": "object",
      "required": ["eligibility_source_ref", "verification_profile_ref", "environment_profile_ref", "host_identity_evidence_ref", "decision_owner_ref", "basis_digest"],
      "properties": {
        "eligibility_source_ref": {"$ref": "https://semantic-guard.local/vnext/schemas/u10-snapshot-environment-adoption-v1.schema.json#/$defs/source_ref"},
        "verification_profile_ref": {"$ref": "https://semantic-guard.local/vnext/schemas/u10-snapshot-environment-adoption-v1.schema.json#/$defs/profile_ref"},
        "environment_profile_ref": {"$ref": "https://semantic-guard.local/vnext/schemas/u10-snapshot-environment-adoption-v1.schema.json#/$defs/environment_ref"},
        "host_identity_evidence_ref": {"$ref": "https://semantic-guard.local/vnext/schemas/u10-snapshot-environment-adoption-v1.schema.json#/$defs/host_ref"},
        "decision_owner_ref": {"$ref": "https://semantic-guard.local/vnext/schemas/u10-snapshot-environment-adoption-v1.schema.json#/$defs/repository_ref"},
        "basis_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    },
    "artifact_denominator": {"type": "object", "required": ["status", "entry_count", "denominator_digest"], "properties": {"status": {"const": "closed"}, "entry_count": {"type": "integer", "minimum": 1}, "denominator_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false},
    "tree_digest": {"$ref": "#/$defs/digest"},
    "snapshot_basis_digest": {"$ref": "#/$defs/digest"},
    "immutability_verified_at": {"type": "string", "format": "date-time"},
    "publication_not_before": {"type": "string", "format": "date-time"},
    "projection_observed_at": {"type": "string", "format": "date-time"},
    "receipt_recorded_at": {"type": "string", "format": "date-time"},
    "publisher_contract_binding": {"$ref": "https://semantic-guard.local/vnext/schemas/u10-control-publisher-contract-binding-v1.schema.json"},
    "projection_occurred": {"const": true},
    "snapshot_manifest_published": {"const": false},
    "snapshot_adoption_status": {"const": "pending_human_decision"},
    "formal_authority": {"const": "none"},
    "positive_assurance_allowed": {"const": false},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"},
    "digest": {"type": "object", "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "unevaluatedProperties": false},
    "ref": {"type": "object", "required": ["authorization_id", "artifact_digest", "authorization_digest"], "properties": {"authorization_id": {"$ref": "#/$defs/id"}, "artifact_digest": {"$ref": "#/$defs/digest"}, "authorization_digest": {"$ref": "#/$defs/digest"}}, "unevaluatedProperties": false}
  },
  "unevaluatedProperties": false
}
