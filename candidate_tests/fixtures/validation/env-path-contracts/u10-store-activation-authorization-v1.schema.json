{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/vnext/schemas/u10-store-activation-authorization-v1.schema.json",
  "title": "semantic-guard U-10 exact store activation authorization v1",
  "description": "A human decision authorizing publication of one exact U-10 store activation basis. It is not engineering correctness, environment qualification, U-4 principal proof, or positive assurance.",
  "type": "object",
  "required": [
    "schema_version",
    "authorization_id",
    "authorization_version",
    "record_kind",
    "human_decision",
    "decision_owner",
    "store_id",
    "store_revision_id",
    "store_version",
    "store_activation_basis_digest",
    "store_activation_basis_ref",
    "authorized_operation",
    "transition_kind",
    "prior_store_ref",
    "prior_revocation_ref",
    "recorded_at",
    "u4_principal_authenticity",
    "authority_scope",
    "formal_authority",
    "positive_assurance_allowed",
    "authorization_digest"
  ],
  "properties": {
    "schema_version": {"const": "semantic-guard-u10-store-activation-authorization/v1"},
    "authorization_id": {"$ref": "#/$defs/stable_id"},
    "authorization_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "record_kind": {"const": "store_activation_authorization"},
    "human_decision": {"const": "accept"},
    "decision_owner": {"const": "human"},
    "store_id": {"$ref": "#/$defs/stable_id"},
    "store_revision_id": {"$ref": "#/$defs/stable_id"},
    "store_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "store_activation_basis_digest": {"$ref": "#/$defs/digest"},
    "store_activation_basis_ref": {"$ref": "#/$defs/root_artifact_ref"},
    "authorized_operation": {"const": "publish_exact_active_store_revision"},
    "transition_kind": {"enum": ["initial_activation", "replace_current_revision"]},
    "prior_store_ref": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/store_ref"}
      ]
    },
    "prior_revocation_ref": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/revocation_ref"}
      ]
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "u4_principal_authenticity": {"const": "unresolved"},
    "authority_scope": {"const": "u10_store_activation_only"},
    "formal_authority": {"const": "human_activation_decision_only"},
    "positive_assurance_allowed": {"const": false},
    "authorization_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "unevaluatedProperties": false
    },
    "root_artifact_ref": {
      "type": "object",
      "required": ["record_id", "locator", "artifact_digest", "semantic_digest"],
      "properties": {
        "record_id": {"$ref": "#/$defs/stable_id"},
        "locator": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))/Library/Application Support/semantic-guard/u10/store-activation-bases/[^\\u0000]+$",
          "maxLength": 4096
        },
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "semantic_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    },
    "store_ref": {
      "type": "object",
      "required": ["store_id", "store_revision_id", "store_version", "store_activation_basis_digest", "artifact_digest", "semantic_digest"],
      "properties": {
        "store_id": {"$ref": "#/$defs/stable_id"},
        "store_revision_id": {"$ref": "#/$defs/stable_id"},
        "store_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "store_activation_basis_digest": {"$ref": "#/$defs/digest"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "semantic_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    },
    "revocation_ref": {
      "type": "object",
      "required": ["revocation_id", "artifact_digest", "semantic_digest"],
      "properties": {
        "revocation_id": {"$ref": "#/$defs/stable_id"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "semantic_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"transition_kind": {"const": "initial_activation"}}, "required": ["transition_kind"]},
      "then": {"properties": {"prior_store_ref": {"type": "null"}, "prior_revocation_ref": {"type": "null"}}}
    },
    {
      "if": {"properties": {"transition_kind": {"const": "replace_current_revision"}}, "required": ["transition_kind"]},
      "then": {"properties": {"prior_store_ref": {"$ref": "#/$defs/store_ref"}}}
    }
  ],
  "unevaluatedProperties": false
}
