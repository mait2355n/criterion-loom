{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/vnext/schemas/environment-eligibility-source-v1.schema.json",
  "title": "semantic-guard environment eligibility source v1",
  "description": "Composition-root source for an exact adoption decision. A caller must pin the source digest independently; the source cannot trust itself.",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "source_version",
    "lifecycle_state",
    "adoption_record",
    "host_observer_ref",
    "resolver_implementation_ref",
    "execution_harness_ref",
    "contract_schema_refs",
    "source_provenance",
    "formal_authority",
    "positive_assurance_allowed",
    "limitations",
    "source_digest"
  ],
  "properties": {
    "schema_version": {"const": "semantic-guard-environment-eligibility-source/v1"},
    "source_id": {"$ref": "#/$defs/stable_id"},
    "source_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "lifecycle_state": {"enum": ["candidate", "adopted", "stale", "revoked"]},
    "adoption_record": {"$ref": "#/$defs/adoption_record"},
    "host_observer_ref": {"$ref": "#/$defs/digest_bound_ref"},
    "resolver_implementation_ref": {"$ref": "#/$defs/digest_bound_ref"},
    "execution_harness_ref": {"$ref": "#/$defs/digest_bound_ref"},
    "contract_schema_refs": {
      "type": "array",
      "minItems": 55,
      "maxItems": 55,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest_bound_ref"},
      "allOf": [
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.local-verification-profile-v4.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.resolved-local-environment-profile-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.local-host-identity-evidence-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.process-containment-probe-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.local-environment-adoption-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.environment-eligibility-source-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.environment-eligibility-resolution-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.governed-environment-execution-receipt-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.closed-verification-test-manifest-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-root-trust-store-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.broker-attested-execution-envelope-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.broker-attested-execution-envelope-v3.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-execution-request-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-execution-snapshot-manifest-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-store-activation-authorization-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-store-revocation-record-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-snapshot-adoption-authorization-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-snapshot-environment-adoption-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-store-activation-authorization-consumption-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-store-activation-transition-receipt-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-store-revocation-authorization-consumption-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-store-revocation-publication-receipt-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-bootstrap-runtime-manifest-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-bootstrap-provenance-binding-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-bootstrap-provisioning-authorization-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-bootstrap-provisioning-consumption-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-bootstrap-provisioning-plan-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-bootstrap-provisioning-receipt-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-bootstrap-runtime-observation-receipt-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-bootstrap-runtime-observation-request-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-control-publisher-contract-binding-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-control-runtime-manifest-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-initial-bootstrap-capsule-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-key-operation-authorization-consumption-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-key-operation-authorization-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-key-operation-receipt-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-signing-key-metadata-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-signing-key-revocation-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-signing-key-selector-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-key-transition-emergency-closure-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-snapshot-activation-authorization-consumption-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-snapshot-activation-basis-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-snapshot-activation-publication-receipt-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-snapshot-projection-authorization-consumption-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-snapshot-projection-authorization-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-snapshot-projection-receipt-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-store-activation-basis-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-candidate-install-authorization-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-candidate-install-authorization-consumption-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-candidate-install-projection-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-candidate-install-receipt-v2.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-preactivation-decision-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-worker-account-observation-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-worker-principal-resolution-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"record_id": {"const": "schema.env-path.u10-root-candidate-bundle-v1.schema.json"}}, "required": ["record_id"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "source_provenance": {
      "type": "object",
      "required": ["evidence_source", "acquisition_method", "inference_status", "decision_owner", "pending_decision"],
      "properties": {
        "evidence_source": {"type": "string", "minLength": 1, "maxLength": 4096},
        "acquisition_method": {"enum": ["human_instruction_transcription", "local_candidate_generation"]},
        "inference_status": {"enum": ["observed", "pending_human_decision"]},
        "decision_owner": {"const": "human"},
        "pending_decision": {"type": "boolean"}
      },
      "unevaluatedProperties": false
    },
    "formal_authority": {"const": "none"},
    "positive_assurance_allowed": {"const": false},
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "source_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "unevaluatedProperties": false
    },
    "digest_bound_ref": {
      "type": "object",
      "required": ["record_id", "locator", "content_digest"],
      "properties": {
        "record_id": {"$ref": "#/$defs/stable_id"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 4096},
        "content_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    },
    "decision_evidence_ref": {
      "type": "object",
      "required": ["record_id", "locator", "content_digest", "trust_domain"],
      "properties": {
        "record_id": {"$ref": "#/$defs/stable_id"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 4096},
        "content_digest": {"$ref": "#/$defs/digest"},
        "trust_domain": {"$ref": "#/$defs/stable_id"}
      },
      "unevaluatedProperties": false
    },
    "environment_profile_ref": {
      "type": "object",
      "required": ["environment_profile_id", "environment_profile_version", "basis_digest"],
      "properties": {
        "environment_profile_id": {"$ref": "#/$defs/stable_id"},
        "environment_profile_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "basis_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    },
    "verification_profile_ref": {
      "type": "object",
      "required": ["profile_id", "profile_version", "content_digest"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/stable_id"},
        "profile_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "content_digest": {"$ref": "#/$defs/digest"}
      },
      "unevaluatedProperties": false
    },
    "adoption_record": {
      "type": "object",
      "required": [
        "schema_version",
        "record_kind",
        "adoption_id",
        "adoption_version",
        "human_decision",
        "recorded_at",
        "environment_profile_ref",
        "execution_scope_ref",
        "decision_owner_ref",
        "decision_owner_authority_evidence_ref",
        "decision_evidence_ref",
        "trusted_entrypoint_ref",
        "formal_authority",
        "positive_assurance_allowed",
        "limitations",
        "adoption_digest"
      ],
      "properties": {
        "schema_version": {"const": "semantic-guard-local-environment-adoption/v1"},
        "record_kind": {"enum": ["adoption_request", "adoption_decision"]},
        "adoption_id": {"$ref": "#/$defs/stable_id"},
        "adoption_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "human_decision": {"enum": ["pending", "accept", "request_revision", "defer", "reject"]},
        "recorded_at": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "environment_profile_ref": {"$ref": "#/$defs/environment_profile_ref"},
        "execution_scope_ref": {"$ref": "#/$defs/verification_profile_ref"},
        "decision_owner_ref": {"$ref": "#/$defs/digest_bound_ref"},
        "decision_owner_authority_evidence_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest_bound_ref"}]
        },
        "decision_evidence_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/decision_evidence_ref"}]
        },
        "trusted_entrypoint_ref": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest_bound_ref"}]
        },
        "formal_authority": {"const": "none"},
        "positive_assurance_allowed": {"const": false},
        "limitations": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "adoption_digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {"properties": {"record_kind": {"const": "adoption_request"}}, "required": ["record_kind"]},
          "then": {
            "properties": {
              "human_decision": {"const": "pending"},
              "recorded_at": {"type": "null"},
              "decision_owner_authority_evidence_ref": {"type": "null"},
              "decision_evidence_ref": {"type": "null"},
              "trusted_entrypoint_ref": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"record_kind": {"const": "adoption_decision"}}, "required": ["record_kind"]},
          "then": {
            "properties": {
              "human_decision": {"enum": ["accept", "request_revision", "defer", "reject"]},
              "recorded_at": {"type": "string", "format": "date-time"},
              "decision_owner_authority_evidence_ref": {"$ref": "#/$defs/digest_bound_ref"},
              "decision_evidence_ref": {"$ref": "#/$defs/decision_evidence_ref"},
              "trusted_entrypoint_ref": {"$ref": "#/$defs/digest_bound_ref"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"lifecycle_state": {"const": "candidate"}}, "required": ["lifecycle_state"]},
      "then": {
        "properties": {
          "adoption_record": {
            "properties": {
              "record_kind": {"const": "adoption_request"},
              "human_decision": {"const": "pending"},
              "recorded_at": {"type": "null"},
              "decision_owner_authority_evidence_ref": {"type": "null"},
              "decision_evidence_ref": {"type": "null"},
              "trusted_entrypoint_ref": {"type": "null"}
            }
          },
          "source_provenance": {
            "properties": {
              "acquisition_method": {"const": "local_candidate_generation"},
              "inference_status": {"const": "pending_human_decision"},
              "pending_decision": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"lifecycle_state": {"const": "adopted"}}, "required": ["lifecycle_state"]},
      "then": {
        "properties": {
          "adoption_record": {
            "properties": {
              "record_kind": {"const": "adoption_decision"},
              "human_decision": {"const": "accept"},
              "recorded_at": {"type": "string", "format": "date-time"},
              "decision_owner_authority_evidence_ref": {"$ref": "#/$defs/digest_bound_ref"},
              "decision_evidence_ref": {"$ref": "#/$defs/decision_evidence_ref"},
              "trusted_entrypoint_ref": {"$ref": "#/$defs/digest_bound_ref"}
            }
          },
          "source_provenance": {
            "properties": {
              "acquisition_method": {"const": "human_instruction_transcription"},
              "inference_status": {"const": "observed"},
              "pending_decision": {"const": false}
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
