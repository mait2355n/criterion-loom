        },
        "population_or_context": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method_types": {"contains": {"const": "not_defined"}}
            },
            "required": ["method_types"]
          },
          "then": {
            "properties": {
              "method_types": {"maxItems": 1},
              "procedure_refs": {"maxItems": 0}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
