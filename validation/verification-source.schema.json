          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/resolution_path"}
        },
        "resolution_summary": {
          "description": "Non-normative human-readable summary of resolution_paths; it must not be used as the machine closure rule.",
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
