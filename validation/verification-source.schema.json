{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/v1/validation/verification-source.schema.json",
  "title": "semantic-guard v1 verification source",
  "description": "Closed internal contract for verification requirements, evidence observations, independent state axes, and human-readable projections. This is not the public audit-result contract and does not grant control or final acceptance authority.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "notation_profile",
    "register_id",
    "title",
    "status",
    "recorded_at",
    "authority_boundary",
    "scope",
    "non_goals",
    "upstream_sources",
    "state_axes",
    "claim_effect_semantics",
    "state_profiles",
    "evidence_observations",
    "evidence_effects",
    "verification_items",
    "implementation_conformance_items",
    "views",
    "unresolved_items",
    "human_acceptance",
    "record_surface"
  ],
  "properties": {
    "$schema": {
      "const": "./verification-source.schema.json"
    },
    "schema_version": {
      "const": "semantic-guard-verification-source/v0"
    },
    "notation_profile": {
      "const": "entity-reference-notation/v0"
    },
    "register_id": {
      "$ref": "../schemas/common.schema.json#/$defs/stable_id"
    },
    "title": {
      "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
    },
    "status": {
      "type": "string",
      "enum": ["active_draft", "superseded", "retired"]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_boundary": {
      "$ref": "#/$defs/authority_boundary"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
      }
    },
    "upstream_sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/upstream_source"
      }
    },
    "state_axes": {
      "$ref": "#/$defs/state_axes"
    },
    "claim_effect_semantics": {
      "$ref": "#/$defs/claim_effect_semantics"
    },
    "state_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/state_profile"
      }
    },
    "evidence_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_observation"
      }
    },
    "evidence_effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_effect"
      }
    },
    "verification_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/verification_item"
      }
    },
    "implementation_conformance_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/conformance_item"
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved_item"
      }
    },
    "human_acceptance": {
      "$ref": "#/$defs/human_acceptance"
    },
    "record_surface": {
      "$ref": "#/$defs/record_surface"
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
      }
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
      }
    },
    "reference_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "../schemas/common.schema.json#/$defs/entity_reference"
      }
    },
    "non_empty_reference_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../schemas/common.schema.json#/$defs/entity_reference"
      }
    },
    "authority_boundary": {
      "type": "object",
      "required": [
        "audit_owner",
        "control_owner",
        "final_acceptance_owner",
        "source_may",
        "source_must_not"
      ],
      "properties": {
        "audit_owner": {
          "const": "semantic-guard"
        },
        "control_owner": {
          "const": "external_caller_or_resource_control_plane"
        },
        "final_acceptance_owner": {
          "const": "human"
        },
        "source_may": {
          "$ref": "#/$defs/string_array"
        },
        "source_must_not": {
          "$ref": "#/$defs/string_array"
        }
      },
      "unevaluatedProperties": false
    },
    "upstream_source": {
      "type": "object",
      "required": ["ref", "path", "authority", "version_or_digest", "limitations"],
      "properties": {
        "ref": {
          "$ref": "../schemas/common.schema.json#/$defs/entity_reference"
        },
        "path": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "authority": {
          "type": "string",
          "enum": [
            "purpose",
            "normative_model",
            "internal_contract",
            "validation_implementation",
            "public_contract",
            "evidence_observation",
            "historical_assessment"
          ]
        },
        "version_or_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "limitations": {
          "$ref": "#/$defs/string_array"
        }
      },
      "unevaluatedProperties": false
    },
    "state_axes": {
      "type": "object",
      "required": [
        "implementation",
        "verification",
        "validation",
        "assurance",
        "freshness",
        "human_acceptance",
        "independence_rule"
      ],
      "properties": {
        "implementation": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "verification": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "validation": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "assurance": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "freshness": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "human_acceptance": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "independence_rule": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        }
      },
      "unevaluatedProperties": false
    },
    "claim_effect_semantics": {
      "type": "object",
      "required": [
        "does_not_block_claim",
        "partially_blocks_claim",
        "blocks_claim"
      ],
      "properties": {
        "does_not_block_claim": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "partially_blocks_claim": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "blocks_claim": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        }
      },
      "unevaluatedProperties": false
    },
    "state": {
      "type": "object",
      "required": [
        "implementation",
        "verification",
        "validation",
        "assurance",
        "freshness"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "enum": ["not_assessed", "missing", "partial", "implemented", "not_applicable"]
        },
        "verification": {
          "type": "string",
          "enum": ["not_run", "passed", "failed", "inconclusive", "invalid", "not_applicable"]
        },
        "validation": {
          "type": "string",
          "enum": ["not_evaluated", "supported_in_context", "refuted_in_context", "inconclusive", "not_applicable"]
        },
        "assurance": {
          "type": "object",
          "required": ["outcome", "finality", "challenge", "coverage"],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["satisfied", "refuted", "undetermined", "not_applicable", "invalid"]
            },
            "finality": {
              "type": "string",
              "enum": ["provisional", "terminal", "invalid"]
            },
            "challenge": {
              "type": "string",
              "enum": ["none", "open", "conflict"]
            },
            "coverage": {
              "type": "string",
              "enum": ["complete", "partial", "not_evaluated", "failed"]
            }
          },
          "unevaluatedProperties": false
        },
        "freshness": {
          "type": "string",
          "enum": ["current", "stale", "unbound"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assurance": {
                "properties": {"finality": {"const": "terminal"}},
                "required": ["finality"]
              }
            },
            "required": ["assurance"]
          },
          "then": {
            "properties": {
              "assurance": {
                "properties": {
                  "outcome": {"enum": ["satisfied", "refuted"]},
                  "challenge": {"const": "none"},
                  "coverage": {"const": "complete"}
                },
                "required": ["outcome", "challenge", "coverage"]
              },
              "freshness": {"const": "current"}
            }
          }
        },
        {
          "if": {
            "properties": {"freshness": {"const": "unbound"}},
            "required": ["freshness"]
          },
          "then": {
            "properties": {
              "assurance": {
                "properties": {
                  "finality": {"const": "provisional"},
                  "coverage": {"enum": ["partial", "not_evaluated", "failed"]}
                },
                "required": ["finality", "coverage"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assurance": {
                "properties": {"finality": {"const": "invalid"}},
                "required": ["finality"]
              }
            },
            "required": ["assurance"]
          },
          "then": {
            "properties": {
              "assurance": {
                "properties": {"outcome": {"const": "invalid"}},
                "required": ["outcome"]
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "state_profile": {
      "type": "object",
      "required": ["entity_id", "label", "meaning", "state"],
      "properties": {
        "entity_id": {
          "$ref": "../schemas/common.schema.json#/$defs/stable_id"
        },
        "label": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "meaning": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      },
      "unevaluatedProperties": false
    },
    "evidence_observation": {
      "type": "object",
      "required": [
        "entity_id",
        "label",
        "source_path",
        "observed_at",
        "evidence_kind",
        "trust_class",
        "acquisition_method",
        "content_digest",
        "subject_binding",
        "elevated_trust_basis",
        "result_summary",
        "scope",
        "limitations",
        "freshness",
        "observation_locators",
        "detail_refs"
      ],
      "properties": {
        "entity_id": {
          "$ref": "../schemas/common.schema.json#/$defs/stable_id"
        },
        "label": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "source_path": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "source_snapshot",
            "test_execution",
            "tool_output",
            "filesystem_observation",
            "human_review",
            "historical_assessment",
            "other"
          ]
        },
        "trust_class": {
          "type": "string",
          "enum": [
            "self_reported",
            "locally_observed",
            "tool_reported",
            "independently_observed",
            "signed",
            "formally_verified",
            "unknown"
          ]
        },
        "acquisition_method": {
          "type": "string",
          "enum": ["file_read", "tool_call", "test_run", "manual_observation", "imported_record", "other"]
        },
        "content_digest": {
          "$ref": "../schemas/common.schema.json#/$defs/digest"
        },
        "subject_binding": {
          "$ref": "#/$defs/subject_binding"
        },
        "elevated_trust_basis": {
          "$ref": "#/$defs/elevated_trust_basis"
        },
        "result_summary": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "scope": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "limitations": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "freshness": {
          "type": "string",
          "enum": ["current", "stale", "unbound"]
        },
        "observation_locators": {
          "description": "Closed locator denominator that evidence effects may cite. A source_path or detail_ref is not automatically an allowed proposition locator.",
          "$ref": "#/$defs/non_empty_string_array"
        },
        "detail_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"freshness": {"const": "current"}},
            "required": ["freshness"]
          },
          "then": {
            "properties": {
              "subject_binding": {
                "properties": {"status": {"const": "bound"}},
                "required": ["status"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"trust_class": {"const": "independently_observed"}},
            "required": ["trust_class"]
          },
          "then": {
            "properties": {
              "elevated_trust_basis": {
                "properties": {
                  "observer_ref": {"type": "string", "minLength": 1},
                  "independence_basis_ref": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"trust_class": {"const": "signed"}},
            "required": ["trust_class"]
          },
          "then": {
            "properties": {
              "elevated_trust_basis": {
                "properties": {
                  "signer_ref": {"type": "string", "minLength": 1},
                  "trust_root_ref": {"type": "string", "minLength": 1},
                  "signature_or_attestation_ref": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"trust_class": {"const": "formally_verified"}},
            "required": ["trust_class"]
          },
          "then": {
            "properties": {
              "elevated_trust_basis": {
                "properties": {
                  "formal_model_ref": {"type": "string", "minLength": 1},
                  "verifier_ref": {"type": "string", "minLength": 1},
                  "formal_verification_result_ref": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_kind": {"const": "test_execution"},
              "subject_binding": {
                "properties": {"status": {"const": "bound"}},
                "required": ["status"]
              }
            },
            "required": ["evidence_kind", "subject_binding"]
          },
          "then": {
            "properties": {
              "subject_binding": {
                "properties": {
                  "manifest_ref": {"type": "string", "minLength": 1},
                  "manifest_digest": {
                    "allOf": [
                      {"$ref": "../schemas/common.schema.json#/$defs/digest"},
                      {
                        "type": "object",
                        "properties": {"algorithm": {"const": "sha256"}}
                      }
                    ]
                  },
                  "environment_ref": {"type": "string", "minLength": 1},
                  "command_or_log_refs": {"minItems": 1}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "subject_binding": {
                "properties": {"status": {"const": "unbound"}},
                "required": ["status"]
              }
            },
            "required": ["subject_binding"]
          },
          "then": {
            "properties": {"freshness": {"enum": ["stale", "unbound"]}}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "evidence_effect": {
      "type": "object",
      "required": [
        "effect_id",
        "item_refs",
        "evidence_ref",
        "effect",
        "claim_dimensions",
        "proposition_scope",
        "observation_locator",
        "limitations"
      ],
      "properties": {
        "effect_id": {
          "$ref": "../schemas/common.schema.json#/$defs/stable_id"
        },
        "item_refs": {
          "$ref": "#/$defs/non_empty_reference_array"
        },
        "evidence_ref": {
          "$ref": "../schemas/common.schema.json#/$defs/entity_reference"
        },
        "effect": {
          "type": "string",
          "enum": ["supports", "refutes", "challenges", "contextualizes"]
        },
        "claim_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "proposition",
              "implementation",
              "verification",
              "validation",
              "assurance",
              "freshness"
            ]
          }
        },
        "lifecycle_surfaces": {
          "description": "Optional subclaim scope for evidence that applies only to named lifecycle-surface assessments within a purpose-coverage item.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "request",
              "exploration_question",
              "requirement",
              "decision_state",
              "plan",
              "action",
              "realization_policy",
              "diff",
              "verification",
              "completion_claim",
              "cross_cutting"
            ]
          }
        },
        "proposition_scope": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "observation_locator": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "limitations": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"effect": {"enum": ["refutes", "challenges"]}},
            "required": ["effect"]
          },
          "then": {
            "properties": {
              "claim_dimensions": {"contains": {"const": "assurance"}}
            }
          }
        },
        {
          "if": {
            "properties": {"effect": {"const": "contextualizes"}},
            "required": ["effect"]
          },
          "then": {
            "properties": {
              "claim_dimensions": {
                "minItems": 1,
                "maxItems": 1,
                "contains": {"const": "proposition"}
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "digest_binding": {
      "type": "object",
      "required": ["subject_locator", "digest"],
      "properties": {
        "subject_locator": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "digest": {
          "$ref": "../schemas/common.schema.json#/$defs/digest"
        }
      },
      "unevaluatedProperties": false
    },
    "subject_binding": {
      "type": "object",
      "required": [
        "status",
        "subject_locators",
        "digest_bindings",
        "manifest_ref",
        "manifest_digest",
        "environment_ref",
        "command_or_log_refs",
        "limitations"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["bound", "partial", "unbound"]
        },
        "subject_locators": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "digest_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest_binding"}
        },
        "manifest_ref": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "manifest_digest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "../schemas/common.schema.json#/$defs/digest"}
          ]
        },
        "environment_ref": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "command_or_log_refs": {
          "$ref": "#/$defs/string_array"
        },
        "limitations": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "bound"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"digest_bindings": {"minItems": 1}}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "elevated_trust_basis": {
      "type": "object",
      "required": [
        "observer_ref",
        "independence_basis_ref",
        "signer_ref",
        "trust_root_ref",
        "signature_or_attestation_ref",
        "formal_model_ref",
        "verifier_ref",
        "formal_verification_result_ref"
      ],
      "properties": {
        "observer_ref": {"type": ["string", "null"], "minLength": 1},
        "independence_basis_ref": {"type": ["string", "null"], "minLength": 1},
        "signer_ref": {"type": ["string", "null"], "minLength": 1},
        "trust_root_ref": {"type": ["string", "null"], "minLength": 1},
        "signature_or_attestation_ref": {"type": ["string", "null"], "minLength": 1},
        "formal_model_ref": {"type": ["string", "null"], "minLength": 1},
        "verifier_ref": {"type": ["string", "null"], "minLength": 1},
        "formal_verification_result_ref": {"type": ["string", "null"], "minLength": 1}
      },
      "unevaluatedProperties": false
    },
    "knowledge_basis": {
      "type": "object",
      "required": [
        "source_ref",
        "locator",
        "version",
        "adoption_status",
        "applicability",
        "counterconditions",
        "limitations",
        "standards_conformance_claimed"
      ],
      "properties": {
        "source_ref": {
          "$ref": "../schemas/common.schema.json#/$defs/entity_reference"
        },
        "locator": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "version": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "adoption_status": {
          "type": "string",
          "enum": ["adopted_internal", "candidate", "missing"]
        },
        "applicability": {
          "$ref": "../schemas/common.schema.json#/$defs/non_empty_string"
        },
        "counterconditions": {
          "$ref": "#/$defs/string_array"
        },
        "limitations": {
          "$ref": "#/$defs/string_array"
        },
        "standards_conformance_claimed": {
          "const": false
        }
      },
      "unevaluatedProperties": false
    },
    "method": {
      "type": "object",
      "required": ["method_types", "procedure_refs", "environment", "population_or_context"],
      "properties": {
        "method_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "test",
              "analysis",
              "inspection",
              "demonstration",
              "formal_verification",
              "operational_observation",
              "human_evaluation",
              "not_defined"
            ]
          }
