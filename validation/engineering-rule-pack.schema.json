{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-guard.local/v1/validation/engineering-rule-pack.schema.json",
  "title": "semantic-guard v1 engineering rule-pack candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "title",
    "purpose",
    "scope",
    "created_at",
    "profile",
    "status",
    "runtime_authority",
    "standards_conformance_claimed",
    "sources",
    "rules",
    "governance",
    "limitations"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "semantic-guard-engineering-rule-pack/v0"},
    "pack_id": {"type": "string", "pattern": "^engineering-rule-pack\\.[a-z0-9.-]+$"},
    "version": {"type": "string", "pattern": "^candidate-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "profile": {"$ref": "#/$defs/profile"},
    "status": {"$ref": "#/$defs/adoptionState"},
    "runtime_authority": {"$ref": "#/$defs/runtimeAuthority"},
    "standards_conformance_claimed": {"type": "boolean"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    },
    "governance": {"$ref": "#/$defs/governance"},
    "limitations": {"$ref": "#/$defs/nonEmptyStrings"}
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "adoptionState": {
      "enum": [
        "candidate_pending_human_adoption",
        "adopted",
        "rejected",
        "superseded"
      ]
    },
    "runtimeAuthority": {
      "enum": ["none", "advisory", "audit_decision"]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "local_locator"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^v[0-9]+$"},
        "local_locator": {
          "const": "src/semantic_guard/profiles.py"
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "algorithm"],
      "properties": {
        "state": {"enum": ["not_computed", "missing", "verified"]},
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "verified"}}},
          "then": {"required": ["value"]},
          "else": {"not": {"required": ["value"]}}
        }
      ]
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "exact_source_text_acquired",
        "observed_at",
        "content_digest",
        "notes"
      ],
      "properties": {
        "state": {
          "enum": [
            "official_locator_metadata_only",
            "official_web_page_observed_not_archived",
            "exact_text_acquired"
          ]
        },
        "exact_source_text_acquired": {"type": "boolean"},
        "observed_at": {"type": "string", "format": "date-time"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "notes": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "version",
        "status",
        "official_locator",
        "section_locators",
        "acquisition",
        "copyright_limit",
        "review_triggers"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^source\\.[a-z0-9.-]+$"},
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "published_current_to_be_revised",
            "official_guidance_web_currentness_unasserted",
            "published_research_metadata_verified"
          ]
        },
        "official_locator": {"type": "string", "format": "uri"},
        "section_locators": {"$ref": "#/$defs/nonEmptyStrings"},
        "acquisition": {"$ref": "#/$defs/acquisition"},
        "copyright_limit": {"type": "string", "minLength": 1},
        "review_triggers": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "localRuleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "locator", "mapping_status"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^direct\\.[a-z0-9.-]+/v[0-9]+$"},
        "locator": {
          "const": "src/semantic_guard/direct_rules.py"
        },
        "mapping_status": {"const": "candidate_semantic_correspondence"}
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "section_locator", "mapping_rationale"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^source\\.[a-z0-9.-]+$"},
        "section_locator": {"type": "string", "minLength": 1},
        "mapping_rationale": {"type": "string", "minLength": 1}
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supersedes", "superseded_by", "policy"],
      "properties": {
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^engineering\\.functional\\.[a-z0-9.-]+@v[0-9]+$"}
        },
        "superseded_by": {
          "type": ["string", "null"],
          "pattern": "^engineering\\.functional\\.[a-z0-9.-]+@v[0-9]+$"
        },
        "policy": {"type": "string", "minLength": 1}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "profile_obligation_refs",
        "local_implementation_rule_refs",
        "engineering_proposition",
        "interpretation",
        "applicability",
        "counterconditions",
        "required_evidence",
        "limitations",
        "source_refs",
        "adoption_state",
        "runtime_authority",
        "adoption_evidence_refs",
        "independent_review_evidence_refs",
        "review_triggers",
        "supersession"
      ],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^engineering\\.functional\\.[a-z0-9.-]+$"},
        "version": {"type": "string", "pattern": "^v[0-9]+$"},
        "profile_obligation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^func\\.[a-z0-9_]+$"}
        },
        "local_implementation_rule_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/localRuleRef"}
        },
        "engineering_proposition": {"type": "string", "minLength": 1},
        "interpretation": {"type": "string", "minLength": 1},
        "applicability": {"$ref": "#/$defs/nonEmptyStrings"},
        "counterconditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "required_evidence": {"$ref": "#/$defs/nonEmptyStrings"},
        "limitations": {"$ref": "#/$defs/nonEmptyStrings"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "adoption_state": {"$ref": "#/$defs/adoptionState"},
        "runtime_authority": {"$ref": "#/$defs/runtimeAuthority"},
        "adoption_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "independent_review_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "review_triggers": {"$ref": "#/$defs/nonEmptyStrings"},
        "supersession": {"$ref": "#/$defs/supersession"}
      }
    },
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs", "authority_ref"],
      "properties": {
        "status": {"enum": ["not_performed", "completed"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authority_ref": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_review",
        "human_adoption",
        "change_control",
        "authority_boundary"
      ],
      "properties": {
        "independent_review": {"$ref": "#/$defs/reviewRecord"},
        "human_adoption": {"$ref": "#/$defs/reviewRecord"},
        "change_control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requires_new_version", "requires_revalidation", "exception_expiry_required"],
          "properties": {
            "requires_new_version": {"$ref": "#/$defs/nonEmptyStrings"},
            "requires_revalidation": {"$ref": "#/$defs/nonEmptyStrings"},
            "exception_expiry_required": {"type": "boolean"}
          }
        },
        "authority_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audit_owner", "adoption_owner", "final_acceptance_owner"],
          "properties": {
            "audit_owner": {"const": "semantic-guard"},
            "adoption_owner": {"const": "human"},
            "final_acceptance_owner": {"const": "human"}
          }
        }
      }
    }
  }
}
